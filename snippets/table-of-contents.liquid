{% comment %}
  {% render 'table-of-contents' , table_of_contents_enable: true %}
{% endcomment %}

{% assign table_of_contents_enable = table_of_contents_enable | default: false %}

{% if table_of_contents_enable %}
  <style>
    /* 親要素のレイアウト */
    div:has(> .table-of-contents-wrapper) {
      display: flex;
      gap: 0px;
      width: 100%;
      max-width: 120rem;
      padding: 0 5rem;
      margin: 0 auto;
    }

    /* 兄弟要素のレイアウト */
    .table-of-contents-wrapper ~ div {
      flex: 1;
    }

    /* 目次ラッパー */
    .table-of-contents-wrapper {
      position: sticky;
      top: 0px;
      padding-top: 10px;
      max-height: 100vh;
      overflow-y: auto;
      background: #fff;
      transition: left 0.3s ease, top 0.2s ease;
      min-width: 200px;
    }
    .table-of-contents-wrapper.open {
      left: 0;
    }

    /* 目次本体 */
    .table-of-contents {
      padding: 10px;
    }
    .table-of-contents__list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .table-of-contents__item {
      margin-bottom: 0.5em;
    }
    .table-of-contents__link {
      display: block;
      padding: 0.5em;
      border-left: 4px solid transparent;
      color: #333;
      text-decoration: none;
      transition: all 0.3s ease;
      font-size: 15px;
    }
    .table-of-contents__link:hover {
      border-left: 4px solid #000;
      opacity: 0.8;
    }
    .table-of-contents__link.is-active {
      border-left: 4px solid #000;
      font-weight: bold;
    }

    /* ハンバーガーボタン */
    .toc-toggle {
      display: none;
      position: fixed;
      left: 0px;
      width: 100%;
      z-index: 999;
      background: #fff;
      border: none;
      font-size: 24px;
      cursor: pointer;
      transition: top 0.1s ease;
    }
    .toc-toggle .toc-toggle-icon {
      margin-right: 8px;
      padding: 6px;
      text-align: left;
      vertical-align: middle;
      padding-bottom: 9px;
    }
    .toc-toggle #activeTocLabel {
      font-size: 15px;
      text-align: left;
      vertical-align: middle;
      width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* スマホ用 */
    @media screen and (max-width: 768px) {
      .two-columns-product-desc {
        flex-direction: column;
      }

      /* TOCラッパーを右外に隠す */
      .table-of-contents-wrapper {
        position: fixed;
        top: 0;
        left: -250px;
        height: 100vh;
        width: 250px;
        max-height: none;
        box-shadow: -2px 0 5px rgba(0, 0, 0, 0.1);
        z-index: 1000;
        padding-top: 70px;
      }
      .toc-toggle {
        display: flex;
        align-items: center;
      }
    }
  </style>

  <!-- 目次ラッパー -->
  <div class="table-of-contents-wrapper" id="tocWrapper">
    <div class="table-of-contents" id="tableOfContents">
      <nav class="table-of-contents__nav">
        <ul class="table-of-contents__list">
          <!-- JavaScriptで動的生成 -->
        </ul>
      </nav>
    </div>
  </div>

  <script>
    class TableOfContents {
      constructor() {
        this.tocWrapper = document.getElementById('tocWrapper');
        this.sections = Array.from(document.querySelectorAll('[data-index]'));
        this.THROTTLE_MS = 16; // 約60FPS（16.67ms）でより滑らかな追跡
        this.lastScroll = window.pageYOffset;
        this.isHeaderVisible = false;
        this.headerObserver = null;
        this.adjustTocPositionFrame = null;
        this.init();
      }

      init() {
        // data-index がなければ目次もボタンも表示しない
        if (this.sections.length === 0) {
          this.tocWrapper.style.display = 'none';
          return;
        }

        // ヘッダー高さ取得
        this.updateHeaderHeight();
        window.addEventListener(
          'resize',
          this.throttle(() => {
            this.updateHeaderHeight();
            this.adjustTocPosition();
          }, this.THROTTLE_MS)
        );

        this.insertToggleButton();
        this.assignIds();
        this.createTocItems();

        // Intersection Observer でヘッダー監視を設定
        this.setupHeaderObserver();

        // 初期位置調整
        this.detectHeaderVisibility();
        this.adjustTocPosition();
        this.onScrollSpy();

        window.addEventListener(
          'scroll',
          this.throttle(() => {
            this.onScrollSpy();
            this.adjustTogglePosition();
          }, this.THROTTLE_MS)
        );

        document.addEventListener('click', (e) => {
          if (!this.tocWrapper.classList.contains('open')) return;
          if (this.tocWrapper.contains(e.target) || this.toggleBtn.contains(e.target)) return;
          this.tocWrapper.classList.remove('open');
        });
      }

      /**
       * Intersection Observer を使用してヘッダーの表示状態を監視
       */
      setupHeaderObserver() {
        const headerEl = document.querySelector('.section-header');
        if (!headerEl) return;

        // 既存のObserverがあれば削除
        if (this.headerObserver) {
          this.headerObserver.disconnect();
        }

        // Intersection Observer の設定
        const observerOptions = {
          root: null, // ビューポートをルートとする
          rootMargin: '0px',
          threshold: [0, 0.1, 0.5, 0.9, 1], // 複数の閾値で細かく監視
        };

        this.headerObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const wasVisible = this.isHeaderVisible;

            // ヘッダーが50%以上表示されている場合を「表示」とする
            this.isHeaderVisible = entry.intersectionRatio > 0.5;

            // 状態が変化した場合のみ目次位置を調整
            if (wasVisible !== this.isHeaderVisible) {
              this.adjustTocPosition();
            }
          });
        }, observerOptions);

        // ヘッダー要素の監視を開始
        this.headerObserver.observe(headerEl);
      }

      updateHeaderHeight() {
        const headerEl = document.querySelector('.section-header');

        // レスポンシブ対応のヘッダー高さ取得
        const windowWidth = window.innerWidth;
        let expectedHeaderHeight;

        if (windowWidth <= 989) {
          expectedHeaderHeight = 66; // モバイル・タブレット
        } else {
          expectedHeaderHeight = 141; // デスクトップ
        }

        // 実際のヘッダー高さを取得（フォールバック）
        const actualHeaderHeight = headerEl ? headerEl.getBoundingClientRect().height : expectedHeaderHeight;

        // より正確な値を使用
        this.HEADER_H = actualHeaderHeight || expectedHeaderHeight;

        // ヘッダーの表示状態を検出
        this.detectHeaderVisibility();

        // 目次の位置を調整
        this.adjustTocPosition();

        if (this.toggleBtn) {
          this.toggleBtn.style.top = `${this.HEADER_H}px`;
        }
      }

      insertToggleButton() {
        const btn = document.createElement('button');
        btn.id = 'tocToggle';
        btn.className = 'toc-toggle';
        btn.setAttribute('aria-label', '目次を開く');
        btn.innerHTML = '<span class="toc-toggle-icon">☰</span><span id="activeTocLabel"></span>';

        const secs = document.querySelectorAll('.shopify-section');
        (secs.length ? secs[secs.length - 1] : document.body).appendChild(btn);

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          this.tocWrapper.classList.toggle('open');
        });

        // 初期 top はヘッダー高さに合わせておく
        btn.style.top = '0';
        this.toggleBtn = btn;
      }

      assignIds() {
        this.sections.forEach((sec) => {
          if (!sec.id) sec.id = `section-${Math.random().toString(36).substr(2, 9)}`;
        });
      }

      createTocItems() {
        const list = this.tocWrapper.querySelector('.table-of-contents__list');
        this.sections.forEach((section, index) => {
          const text = section.getAttribute('data-index'),
            id = section.id;
          const li = document.createElement('li');
          li.className = 'table-of-contents__item';

          const a = document.createElement('a');
          a.href = `#${id}`;
          a.className = 'table-of-contents__link';
          a.textContent = text;
          a.addEventListener('click', (e) => {
            e.preventDefault();

            // GTM経由でGA4に送信（最も確実な方法）
            if (typeof dataLayer !== 'undefined') {
              dataLayer.push({
                event: 'toc_click',
                toc_section_name: text,
                toc_section_id: id,
                toc_section_index: index + 1,
                page_url: window.location.href,
                page_title: document.title,
              });
            }

            this.scrollToSection(section);
          });

          li.appendChild(a);
          list.appendChild(li);
        });
      }

      onScrollSpy() {
        let closest = null,
          minDist = Infinity;
        this.sections.forEach((sec) => {
          const dist = Math.abs(sec.getBoundingClientRect().top - this.HEADER_H);
          if (dist < minDist) {
            minDist = dist;
            closest = sec;
          }
        });
        if (!closest) return;

        document.getElementById('activeTocLabel').textContent = closest.getAttribute('data-index');
        this.tocWrapper.querySelectorAll('.is-active').forEach((el) => el.classList.remove('is-active'));
        const link = this.tocWrapper.querySelector(`a[href="#${closest.id}"]`);
        if (link) link.classList.add('is-active');
      }

      adjustTogglePosition() {
        const curY = window.pageYOffset;
        if (curY > this.lastScroll) {
          this.toggleBtn.style.top = '0';
        } else {
          this.toggleBtn.style.top = `${this.HEADER_H - 3}px`;
        }
        this.lastScroll = curY;
      }

      /**
       * ヘッダーの表示状態を検出
       */
      detectHeaderVisibility() {
        const headerEl = document.querySelector('.section-header');
        if (!headerEl) {
          this.isHeaderVisible = false;
          return;
        }

        const headerRect = headerEl.getBoundingClientRect();
        const headerTop = headerRect.top;

        // ヘッダーが画面上部に完全に表示されているかチェック
        this.isHeaderVisible = headerTop >= -10; // 少しの余裕を持たせる

        // デバッグ用（本番では削除可能）
        // console.log('Header visibility:', this.isHeaderVisible, 'Header top:', headerTop);
      }

      /**
       * 目次の位置を動的に調整（ヘッダーとの被りを防ぐ）
       */
      adjustTocPosition() {
        if (!this.tocWrapper) return;

        // デスクトップのみで動作（モバイルは既存のドロワー形式）
        if (window.innerWidth <= 768) return;

        // requestAnimationFrame を使用して滑らかな更新
        if (this.adjustTocPositionFrame) {
          cancelAnimationFrame(this.adjustTocPositionFrame);
        }

        this.adjustTocPositionFrame = requestAnimationFrame(() => {
          const currentTop = parseInt(getComputedStyle(this.tocWrapper).top) || 0;
          let newTop = 0;

          if (this.isHeaderVisible) {
            // ヘッダーが表示されている場合、被りを計算
            const overlap = this.HEADER_H - currentTop;

            if (overlap > 0) {
              // 被る分だけ下げる
              newTop = this.HEADER_H;
            } else {
              // 既に十分下にある場合はそのまま
              newTop = currentTop;
            }
          } else {
            // ヘッダーが隠れている場合は元の位置（通常は0またはpadding-top分）
            newTop = 10; // padding-topの値
          }

          // 位置を更新（変更がある場合のみ）
          if (Math.abs(currentTop - newTop) > 1) {
            this.tocWrapper.style.top = `${newTop}px`;
          }
        });
      }

      scrollToSection(section) {
        const top = section.getBoundingClientRect().top + window.pageYOffset;
        window.scrollTo({ top: top - this.HEADER_H, behavior: 'smooth' });
      }

      throttle(fn, wait) {
        let lastTime = 0;
        return (...args) => {
          const now = Date.now();
          if (now - lastTime >= wait) {
            lastTime = now;
            fn.apply(this, args);
          }
        };
      }
    }

    document.addEventListener('DOMContentLoaded', () => new TableOfContents());
  </script>
{% endif %}
