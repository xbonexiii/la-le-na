{% comment %}
  カートリンクボタン（カートドロワー・カートページ共通）

  使用例:
  {% render 'cart-link-buttons', tracking_event: 'cart_drawer_link_button_click' %}
  {% render 'cart-link-buttons', tracking_event: 'cart_page_link_button_click' %}

  パラメータ:
  - tracking_event: トラッキングイベント名
{% endcomment %}

<style>
  .cart-link-buttons a {
    margin-top: 1rem;
  }

  {% if settings.cart_type == 'page' %}
  .cart-link-buttons {
    margin-top: 2rem;
  }

  .cart-link-buttons a {
    max-width: 36rem;
    margin: auto;
  }

  .cart-link-buttons a:not(:first-child) {
    margin-top: 2rem;
  }
  {% endif %}
</style>

{%- style -%}
  /* カートリンクボタンを縦並びにする */
  .cart-link-buttons {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .cart-link-buttons .cart-link-button {
    width: 100%;
  }

  /* リンクボタンのホバー効果をチェックアウトボタンと合わせる */
  .cart-link-button {
    position: relative;
    transition: box-shadow var(--duration-short) ease;
  }

  /* ホバー時に色が薄くならないようにする */
  .cart-link-button:hover {
    opacity: 1 !important;
  }

  /* インラインスタイルの背景色をホバー時も維持 */
  .cart-link-button[style*='background-color'] {
    background-color: var(--link-button-bg-color) !important;
  }

  .cart-link-button[style*='background-color']:hover {
    background-color: var(--link-button-bg-color) !important;
  }

  /* span要素を::after疑似要素の上に配置 */
  .cart-link-button span {
    position: relative;
    z-index: 2;
  }

  /* a要素の.buttonでも::after疑似要素が正しく動作するようにする */
  a.cart-link-button::after {
    content: '';
    position: absolute;
    top: var(--buttons-border-width);
    right: var(--buttons-border-width);
    bottom: var(--buttons-border-width);
    left: var(--buttons-border-width);
    z-index: 1;
    border-radius: var(--buttons-radius);
    box-shadow: 0 0 0 calc(var(--buttons-border-width) + var(--border-offset))
        rgba(var(--color-button-text), var(--border-opacity)),
      0 0 0 var(--buttons-border-width) rgba(var(--color-button), var(--alpha-button-background));
    transition: box-shadow var(--duration-short) ease;
    pointer-events: none;
  }

  a.cart-link-button:not([disabled]):hover::after {
    --border-offset: 1.3px;
    box-shadow: 0 0 0 calc(var(--buttons-border-width) + var(--border-offset))
        rgba(var(--color-button-text), var(--border-opacity)),
      0 0 0 calc(var(--buttons-border-width) + 1px) rgba(var(--color-button), var(--alpha-button-background));
  }
{%- endstyle -%}

<div class="cart-link-buttons">
  {%- for i in (1..3) -%}
    {%- liquid
      assign enabled_setting = 'cart_drawer_link_button_' | append: i | append: '_enabled'
      assign text_setting = 'cart_drawer_link_button_' | append: i | append: '_text'
      assign url_setting = 'cart_drawer_link_button_' | append: i | append: '_url'
      assign bg_color_setting = 'cart_drawer_link_button_' | append: i | append: '_background_color'
      assign text_color_setting = 'cart_drawer_link_button_' | append: i | append: '_text_color'

      assign is_enabled = settings[enabled_setting]
      assign button_text = settings[text_setting]
      assign button_url = settings[url_setting]
      assign button_bg_color = settings[bg_color_setting]
      assign button_text_color = settings[text_color_setting]

      if button_bg_color == blank
        assign button_bg_color = '#ffffff'
      endif

      if button_text_color == blank
        assign button_text_color = '#000000'
      endif
    -%}
    {%- if is_enabled and button_url != blank -%}
      <a
        href="{{ button_url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="button button--full-width cart-link-button"
        style="background-color: {{ button_bg_color }}; color: {{ button_text_color }}; --link-button-bg-color: {{ button_bg_color }}; --link-button-text-color: {{ button_text_color }};"
        data-button-index="{{ i }}"
        data-button-text="{{ button_text | escape }}"
        data-button-url="{{ button_url | escape }}"
        data-tracking-event="{{ tracking_event }}"
      >
        <span>
          {%- if button_text != blank -%}
            {{ button_text }}
          {%- else -%}
            テキストを入力してください
          {%- endif -%}
        </span>
      </a>
    {%- endif -%}
  {%- endfor -%}
</div>

{%- comment -%} トラッキングスクリプト {%- endcomment -%}
<script>
  (function () {
    // イベントリスナーを設定
    function setupTracking() {
      const linkButtons = document.querySelectorAll('.cart-link-button[data-tracking-event]');

      linkButtons.forEach(function (button) {
        // 既にイベントリスナーが設定されている場合はスキップ（重複登録を防ぐ）
        if (button.hasAttribute('data-tracking-setup')) {
          return;
        }

        button.setAttribute('data-tracking-setup', 'true');

        button.addEventListener(
          'click',
          function (e) {
            const buttonIndex = this.getAttribute('data-button-index');
            const buttonText = this.getAttribute('data-button-text') || 'テキスト未設定';
            const buttonUrl = this.getAttribute('data-button-url');
            const eventName = this.getAttribute('data-tracking-event');

            // Google Analytics (gtag.js) にイベントを送信
            if (typeof gtag !== 'undefined') {
              gtag('event', eventName, {
                event_label: 'Button ' + buttonIndex + ': ' + buttonText,
                button_index: buttonIndex,
                button_text: buttonText,
                button_url: buttonUrl,
                value: 1,
              });
            }

            // Google Tag Manager (dataLayer) にイベントを送信
            if (typeof window.dataLayer !== 'undefined') {
              window.dataLayer.push({
                event: eventName,
                eventLabel: 'Button ' + buttonIndex + ': ' + buttonText,
                buttonIndex: buttonIndex,
                buttonText: buttonText,
                buttonUrl: buttonUrl,
              });
            }
          },
          { capture: true }
        );
      });
    }

    // 即座に設定を試みる
    setupTracking();

    // DOMContentLoaded時にも設定（念のため）
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupTracking);
    } else {
      // 既に読み込み完了している場合は少し遅延させて再設定
      setTimeout(setupTracking, 100);
    }
  })();
</script>
