    "image_banner_WyUnBF": {
      "type": "image-banner",
      "blocks": {
        "heading_yVCFCy": {
          "type": "heading",
          "settings": {
            "heading": "Ra Le-Na",
            "heading_size": "h1"
          }
        },
        "text_mmH9Jy": {
          "type": "text",
          "settings": {
            "text": "「毎日、毎日、使いやすい。」その一言のために、500人の主婦と2年かけて生まれたRa Le-Naのまな板。滑らず安定して切れる、汚れやニオイが残らない、包丁を傷めにくく、食洗機や漂白剤にも対応。“よくあるストレス”をすべて解消するために、素材の開発から形状まで一から設計し直しました。抗菌性や耐久性、扱いやすさを兼ね備えた独自設計で、どんな料理も快適にサポート。使うたびに「これでよかった」と思える、そんな1枚をあなたのキッチンにも。開発の裏側や、選ばれる理由をもっと知りたい方はこちらからご覧ください。",
            "text_style": "body"
          }
        },
        "buttons_ceWXRt": {
          "type": "buttons",
          "settings": {
            "button_label_1": "Ra Le-Na 製品ページを見る",
            "button_link_1": "shopify://products/ra-le-na",
            "button_style_secondary_1": true,
            "button_label_2": "",
            "button_link_2": "",
            "button_style_secondary_2": false
          }
        }
      },
