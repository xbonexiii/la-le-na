      "settings": {
        "custom_liquid": "<a href=\"https://lin.ee/rDDhEF8\" class=\"line-sticky-banner\" target=\"_blank\" rel=\"noopener noreferrer\">\n  <img src=\"https://cdn.shopify.com/s/files/1/0692/1037/4325/files/251212_01__Shopify-RaLeNa.png?v=1765524018\" alt=\"LINE誘導バナー\" class=\"banner-image\">\n</a>\n\n<style>\n/* LINE誘導バナー */\n.line-sticky-banner {\n  position: fixed;\n  bottom: 30px;\n  right: 30px;\n  z-index: 1000;\n  display: block;\n  max-width: 350px;\n  width: 100%;\n  box-sizing: border-box;\n\n  /* 角丸を“親”に持たせる（pill形状） */\n  border-radius: 9.84px;           /* ← ここが肝。画像のradius=170px相当でもOK */\n  overflow: hidden;                 /* はみ出し防止（光沢も内側に） */\n  box-shadow: 0 4px 15px rgba(0,0,0,0.2);\n\n  /* 拡大は親に適用、右下を基点に */\n  transform-origin: right bottom;\n  transition: transform .3s ease, box-shadow .3s ease;\n  will-change: transform;\n  text-decoration: none;\n\n  /* Safariで角が角ばる場合の保険（任意） */\n  -webkit-backface-visibility: hidden;\n  backface-visibility: hidden;\n}\n\n@media screen and (max-width: 500px) {\n  .line-sticky-banner {\n    bottom: 5px;\n    right: 0;\n    padding: 0px;\nmargin:0 10px 5px 0;\n    max-width: 250px;\n  }\n}\n\n.line-sticky-banner .banner-image {\n  width: 100%;\n  height: auto;\n  display: block;\n  border-radius: inherit;           /* 親と同じ角丸を継承 */\n  box-shadow: none;\n}\n\n.line-sticky-banner:hover {\n  transform: translateY(-2px) scale(1.04);  /* お好みで1.02〜1.06 */\n  box-shadow: 0 6px 20px rgba(0,0,0,0.3);\n}\n\n/* 子画像側の拡大はしない（親で拡大） */\n.line-sticky-banner:hover .banner-image {\n  transform: none;\n}\n\n/* 光沢エフェクト */\n.line-sticky-banner::before {\n  content: '';\n  position: absolute;\n  top: -50%;\n  left: -100%;\n  width: 200%;\n  height: 200%;\n  background: linear-gradient(45deg, rgba(255,255,255,0.3), rgba(255,255,255,0));\n  transform: rotate(45deg);\n  animation: shine-left-to-right 3s linear infinite;\n  opacity: 1;\n  z-index: 1;\n  pointer-events: none;\n}\n\n@keyframes shine-left-to-right {\n  0%   { left: -100%; }\n  100% { left: 100%; }\n}\n\n@supports (-webkit-touch-callout: none) {\n  .line-sticky-banner { -webkit-mask-image: -webkit-radial-gradient(white, black); }\n}\n\n</style>",
