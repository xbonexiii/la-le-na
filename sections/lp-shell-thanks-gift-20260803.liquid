<style>

/* Shopify反映時は head のリンクタグが liquid に入らずフォントが崩れるため、@import でも読み込む
   （standalone表示では link と重複するがブラウザ側で重複解決される）
   ※ 2026-08-31: この行に山かっこ付きのタグ名を書くと、ビルドのCSS混入チェックが
     「CSSにHTMLの断片が混じった」と誤検知して中断する。タグ名は素の文字で書くこと。 */
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600;700;900&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap');
/* ================== tokens.css（library/土台・インライン内包） ================== */
:root {
  --gold: #A37729; --gold-light: #c49535; --gold-tint: rgba(163,119,41,.1);
  --blue: #0071e3; --text: #1d1d1f; --text-sub: #6e6e73;
  --bg-white: #ffffff; --bg-gray: #f5f5f7; --bg-dark: #1d1d1f; --star: #f5c518;
  --fs-hero: clamp(32px, 5.5vw, 68px); --fs-hero-compact: clamp(30px, 4.2vw, 54px);
  --fs-h2: clamp(28px, 3.5vw, 44px); --fs-h3: 24px; --fs-stat: clamp(28px, 3.6vw, 48px);
  /* 2026-08-03 市山さん指示: 最小文字サイズを16pxにする。
     note/micro を 13/12px から 16px へ引き上げ、本文・リードも一段上げて
     16（注記・キャプション）< 18（本文）< 19-22（リード）< 24（h3）< 28-44（h2）の階層にした。
     16px より下は作らないため、注記とキャプションは同じ大きさになり、差は色と太さで付けている。 */
  --fs-lead: clamp(19px, 1.7vw, 22px); --fs-body: 18px; --fs-note: 16px; --fs-micro: 16px;
  --ls-hero: -0.03em; --ls-heading: -0.02em; --ls-num: -0.04em;
  /* 角丸は8pxで統一（2026-08-04 市山さん指示）。付けない=0 はそのまま有効・真円50%は対象外 */
  --radius-card: 8px; --radius-image: 8px; --radius-badge: 8px; --radius-pill: 8px;
  --shadow-card: 0 2px 20px rgba(0,0,0,.06);
  --section-pad: 100px; --section-pad-sp: 64px;
}
/* ================== base.css（library/土台・インライン内包） ================== */
.lp-wrapper *,  .lp-wrapper *::before,  .lp-wrapper *::after{ box-sizing: border-box; margin: 0; padding: 0; }
.lp-wrapper{ scroll-behavior: smooth; }
.lp-wrapper{ font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 400; color: var(--text); font-size: var(--fs-body); line-height: 1.7; overflow-x: hidden; }
.lp-wrapper strong,  .lp-wrapper b{ font-weight: 700; }
.lp-wrapper img{ max-width: 100%; height: auto; display: block; }
.lp-wrapper a{ color: inherit; text-decoration: none; }
.lp-wrapper section{ width: 100%; }
/* 見出しは常にコンテナの色を継承（Shopify反映時にテーマの h1,h2{color:#1d1d1f} 直接指定へ負ける再発バグ対策） */
.lp-wrapper h1,  .lp-wrapper h2,  .lp-wrapper h3,  .lp-wrapper h4,  .lp-wrapper h5,  .lp-wrapper h6{ color: inherit; font-family: "Noto Serif Japanese", "Noto Serif JP", "Zen Kaku Gothic New", serif; font-weight: 400; }
.lp-wrapper .section-padding{ padding-top: var(--section-pad); padding-bottom: var(--section-pad); }
.lp-wrapper .hd-nowrap{ white-space: nowrap; }
@media (max-width: 768px) {
  .lp-wrapper{ font-size: 17px; }
  .lp-wrapper .section-padding{ padding-top: var(--section-pad-sp); padding-bottom: var(--section-pad-sp); }
}
.lp-wrapper .fade-in{ opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
.lp-wrapper .fade-in.visible{ opacity: 1; transform: translateY(0); }
.lp-wrapper .slide-up{ opacity: 0; transform: translateY(32px); transition: opacity 0.7s ease, transform 0.7s ease; }
.lp-wrapper .slide-left{ opacity: 0; transform: translateX(-48px); transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-right{ opacity: 0; transform: translateX(48px); transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-up.visible,  .lp-wrapper .slide-left.visible,  .lp-wrapper .slide-right.visible{ opacity: 1; transform: none; }
.lp-wrapper .delay-1{ transition-delay: .15s; } .delay-2 { transition-delay: .3s; } .delay-3 { transition-delay: .45s; } .delay-4 { transition-delay: .6s; }
.lp-wrapper .btn-primary{ display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--gold); color: #fff; font-size: 18px; font-weight: 700; padding: 18px 40px; border-radius: var(--radius-pill); cursor: pointer; transition: background 0.2s, transform 0.1s; border: none; letter-spacing: 0.02em; }
.lp-wrapper .btn-primary:hover{ background: var(--gold-light); transform: translateY(-1px); }
.lp-wrapper .scroll-hint{ position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 6px; color: rgba(255,255,255,0.6); font-size: 16px; letter-spacing: 0.15em; text-transform: uppercase; animation: scroll-bounce 2.2s infinite; }
.lp-wrapper .scroll-hint svg{ width: 20px; height: 20px; }
@keyframes scroll-bounce { 0%, 100% { transform: translateX(-50%) translateY(0); opacity: .55; } 50% { transform: translateX(-50%) translateY(8px); opacity: .9; } }

/* ================== RaLe-Na テーマ（tokens/base の後・色の値だけ上書き） ================== */
:root {
  --gold: #d75a41; --gold-light: #C9AC82; --gold-tint: rgba(215,90,65,.07);
  /* 2026-08-03 市山さん指示: ボタンは青。--cta-light はホバー用（押せる感を出すため一段濃い青） */
  --cta: #1E6FD9; --cta-light: #1557B0; --bridge: #A86A3C;
  --bg-white: #FBF7F0; --bg-gray: #F5EFE6; --bg-dark: #1B2845;
  --text: #2B2B2B; --text-sub: #6E655A; --star: #E0A93B;
  --navy: #1B2845; --wine: #d75a41; --beige: #C9AC82; --cream: #F5EFE6; --green: #8FA88A;
  --line: rgba(27,40,69,.14);
  /* 各モールのブランドカラー（カード上端の識別帯として使用。ロゴ画像と併用） */
  --c-rakuten: #BF0000; --c-official: #1B2845; --c-yahoo: #FF0033; --c-amazon: #FF9900;
}
.lp-wrapper .btn-primary{ background: var(--cta); }
.lp-wrapper .btn-primary:hover{ background: var(--cta-light); }
.lp-wrapper{ line-height: 1.9; background: var(--bg-white); }
/* 洗練の調整: 余白を広げ、色数を絞り、区切りは背景色でなく余白と細罫線で作る */
:root { --section-pad: 118px; --section-pad-sp: 76px; }

/* ================== 共通の器 ================== */
.lp-wrapper .inner{ max-width: 880px; width: calc(100% - 48px); margin: 0 auto; text-align: left; }
.lp-wrapper .inner-narrow{ max-width: 760px; width: calc(100% - 48px); margin: 0 auto; text-align: left; }
.lp-wrapper .inner-wide{ max-width: 1120px; width: calc(100% - 48px); margin: 0 auto; text-align: left; }
/* 見出しの統一リズム: 明朝＋字間ゆるめ＋下に短いベージュ罫（全セクション共通の統制） */
.lp-wrapper .sec-h2{ font-size: var(--fs-h2); font-weight: 400; line-height: 1.5; letter-spacing: .02em; color: var(--navy); }
.lp-wrapper .sec-h2::after{ content: ""; display: block; width: 44px; height: 1px; background: var(--beige); margin-top: 22px; }
.lp-wrapper .sec-h2.is-center{ text-align: center; }
.lp-wrapper .sec-h2.is-center::after{ margin-left: auto; margin-right: auto; }
.lp-wrapper .lead{ font-size: var(--fs-body); line-height: 2.05; color: var(--text); text-wrap: pretty; }
@media (max-width: 768px) {
  .lp-wrapper .inner,  .lp-wrapper .inner-narrow,  .lp-wrapper .inner-wide{ width: calc(100% - 40px); }
  .lp-wrapper .sec-h2::after{ margin-top: 18px; }
}

/* ================== 1. sec-hero（FV・写真オーバーレイ） ==================
   下敷き: hero/フルスクリーン左下寄せ（フル背景＋暗幕グラデ＋左下寄せ）
          ＋ hero/商流2FV_キャッチ主役写真型（コピーを2ブロックに絞る）
   旧見出し画像 title-reviewpage.png の造形（緑の吹き出しアイコン／枠囲みの「専用スクレパー」／
   赤丸の「数量限定4000枚」）を、文言だけ規約セーフに差し替えてHTML/CSSで組み直している。 */
.lp-wrapper #sec-hero{ position: relative; min-height: 92vh; min-height: 92svh; display: flex; align-items: flex-end; color: #fff; background: var(--navy); }
.lp-wrapper #sec-hero .hero-bg{ position: absolute; inset: 0; overflow: hidden; }
.lp-wrapper #sec-hero .hero-bg img{ width: 100%; height: 100%; object-fit: cover; object-position: center 42%; }
/* 暗幕: 下を濃く上を薄く（白文字の可読性）＋ネイビー寄りの色味でブランドトーンに寄せる */
.lp-wrapper #sec-hero .hero-bg::after{ content: ""; position: absolute; inset: 0; background:
  linear-gradient(to top, rgba(20,28,45,.92) 0%, rgba(20,28,45,.60) 48%, rgba(20,28,45,.20) 100%),
  linear-gradient(to right, rgba(20,28,45,.52) 0%, rgba(20,28,45,.16) 62%, rgba(20,28,45,0) 100%); }
.lp-wrapper #sec-hero .hero-inner{ position: relative; z-index: 1; width: 100%; max-width: 1120px; margin: 0 auto; padding: 120px 40px 124px; }
.lp-wrapper #sec-hero .hero-thanks{ font-size: var(--fs-note); font-weight: 700; letter-spacing: .12em; color: var(--beige); margin-bottom: 24px; text-shadow: 0 1px 3px rgba(0,0,0,.4); }
.lp-wrapper #sec-hero .hero-head{ display: flex; align-items: center; gap: 40px; flex-wrap: wrap; }
.lp-wrapper #sec-hero h1{ color: #fff; font-weight: 400; letter-spacing: .06em; line-height: 1.5; text-shadow: 0 1px 6px rgba(0,0,0,.45); }
.lp-wrapper #sec-hero h1 .l1{ display: flex; align-items: center; gap: 14px; font-size: clamp(23px, 3.4vw, 40px); margin-bottom: 16px; }
.lp-wrapper #sec-hero h1 .l2{ display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font-size: clamp(26px, 4.1vw, 46px); }
.lp-wrapper #sec-hero h1 .ic-chat{ width: clamp(29px, 3.2vw, 40px); height: auto; color: var(--green); flex-shrink: 0; }
.lp-wrapper #sec-hero h1 .boxed{ display: inline-block; border: 1px solid rgba(255,255,255,.85); padding: 6px 18px 8px; letter-spacing: .1em; }
.lp-wrapper #sec-hero .qty-badge{ flex-shrink: 0; width: clamp(108px, 12.5vw, 146px); height: clamp(108px, 12.5vw, 146px); border-radius: 50%; background: var(--wine); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; box-shadow: 0 6px 24px rgba(0,0,0,.28); }
.lp-wrapper #sec-hero .qty-badge .q-cap{ font-size: clamp(16px, 1.2vw, 17px); font-weight: 700; letter-spacing: .08em; }
.lp-wrapper #sec-hero .qty-badge .q-num{ font-family: "Noto Serif Japanese", "Noto Serif JP", serif; font-size: clamp(31px, 3.1vw, 37px); font-weight: 400; line-height: 1.15; letter-spacing: .02em; }
.lp-wrapper #sec-hero .qty-badge .q-num em{ font-style: normal; font-size: .52em; margin-left: 2px; }
.lp-wrapper #sec-hero .hero-lead{ font-size: var(--fs-lead); line-height: 1.95; color: rgba(255,255,255,.92); max-width: 620px; margin-top: 34px; text-shadow: 0 1px 4px rgba(0,0,0,.45); text-wrap: pretty; }
/* PCのみ中央寄せ（2026-08-03 市山さん指示。スマホは従来の左寄せ・下寄せのまま）。
   横だけ中央にして下寄せのままだと重心が左下に残って不揃いに見えるため、縦も中央に置き、
   左を濃くする方向グラデーションを中央が濃い対称のものへ差し替えて、文字の乗る面をそろえている。 */
@media (min-width: 769px) {
  .lp-wrapper #sec-hero{ align-items: center; }
  .lp-wrapper #sec-hero .hero-bg::after{ background:
    linear-gradient(to top, rgba(20,28,45,.86) 0%, rgba(20,28,45,.56) 52%, rgba(20,28,45,.34) 100%),
    radial-gradient(ellipse 78% 62% at 50% 50%, rgba(20,28,45,.40) 0%, rgba(20,28,45,0) 100%); }
  .lp-wrapper #sec-hero .hero-inner{ text-align: center; padding: 120px 40px; }
  /* 数量バッジを見出しと横並びのままにすると、見出しがバッジのぶん左へ押されて
     「中央に見えない」ため、PCではバッジだけ右へ逃がし、見出しを面の真ん中に置く。 */
  .lp-wrapper #sec-hero .hero-head{ display: block; position: relative; }
  .lp-wrapper #sec-hero h1 .l1,  .lp-wrapper #sec-hero h1 .l2{ justify-content: center; }
  .lp-wrapper #sec-hero .qty-badge{ position: absolute; right: 0; top: 50%; transform: translateY(-50%); }
  .lp-wrapper #sec-hero .hero-lead{ margin-left: auto; margin-right: auto; }
}
/* 769〜1024px は見出しの実寸が面幅に近づき、右のバッジとの間が詰まるため、バッジだけ一段小さくする */
@media (min-width: 769px) and (max-width: 1024px) {
  .lp-wrapper #sec-hero .qty-badge{ width: 118px; height: 118px; right: -18px; }
  .lp-wrapper #sec-hero .qty-badge .q-num{ font-size: 31px; }
}
@media (max-width: 768px) {
  .lp-wrapper #sec-hero{ align-items: center; }
  .lp-wrapper #sec-hero .hero-inner{ padding: 96px 20px 104px; }
  .lp-wrapper #sec-hero .hero-head{ gap: 24px; }
  .lp-wrapper #sec-hero h1 .l1,  .lp-wrapper #sec-hero h1 .l2{ gap: 10px; }
  .lp-wrapper #sec-hero .hero-lead{ margin-top: 26px; }
}

/* ================== 2. sec-gift-intro（プレゼント案内・ステートメント） ==================
   下敷き: summary/ステートメント余白宣言型（器・色・装飾を持たず、余白と一文で伝える） */
.lp-wrapper #sec-gift-intro{ background: var(--bg-white); padding-top: calc(var(--section-pad) * 1.25); padding-bottom: calc(var(--section-pad) * 1.25); }
.lp-wrapper #sec-gift-intro .gi-inner{ max-width: 820px; width: calc(100% - 48px); margin: 0 auto; text-align: center; }
.lp-wrapper #sec-gift-intro .gi-eyebrow{ font-size: var(--fs-note); font-weight: 700; letter-spacing: .14em; color: var(--wine); margin-bottom: 30px; }
.lp-wrapper #sec-gift-intro .gi-line{ font-size: var(--fs-hero-compact); font-weight: 400; line-height: 1.65; letter-spacing: .02em; color: var(--navy); }
.lp-wrapper #sec-gift-intro .gi-line em{ font-style: normal; color: var(--wine); }
.lp-wrapper #sec-gift-intro .gi-sub{ font-size: var(--fs-lead); line-height: 2.05; color: var(--text); margin-top: 34px; text-wrap: pretty; }
.lp-wrapper #sec-gift-intro .gi-facts{ display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 34px; }
.lp-wrapper #sec-gift-intro .gi-facts span{ display: inline-flex; align-items: center; gap: 8px; font-size: var(--fs-note); font-weight: 700; color: var(--navy); background: var(--cream); border-radius: var(--radius-pill); padding: 9px 20px; white-space: nowrap; }
.lp-wrapper #sec-gift-intro .gi-facts svg{ width: 15px; height: 15px; color: var(--wine); }
@media (max-width: 768px) {
  .lp-wrapper #sec-gift-intro{ padding-top: calc(var(--section-pad-sp) * 1.3); padding-bottom: calc(var(--section-pad-sp) * 1.3); }
  .lp-wrapper #sec-gift-intro .gi-inner{ text-align: left; }
  .lp-wrapper #sec-gift-intro .gi-facts{ justify-content: flex-start; }
}

/* ================== 3. sec-scraper（スクレパー紹介・動画＋用途3つ） ==================
   下敷き: features/商流2速さ電池小さい_交互2カラム型（説明×ビジュアル）
          ＋ compatible/商流2これ1台_実写真カード型（用途を並べる一覧の作法） */
.lp-wrapper #sec-scraper{ background: var(--cream); padding-bottom: 0; }
.lp-wrapper #sec-scraper h2{ margin-bottom: 26px; }
.lp-wrapper #sec-scraper .sc-body{ margin-bottom: 34px; }
.lp-wrapper #sec-scraper .sc-body p{ font-size: var(--fs-body); line-height: 2.05; color: var(--text); margin-bottom: 18px; }
.lp-wrapper #sec-scraper .sc-body p:last-child{ margin-bottom: 0; }
.lp-wrapper #sec-scraper .sc-media{ border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--shadow-card); margin-bottom: 46px; background: #fff; }
.lp-wrapper #sec-scraper .sc-media video{ width: 100%; display: block; }
/* 用途3つ（現ページ Frame_4.png の円形3連をHTMLで再構成） */
/* 効能3点（2026-08-04 市山さん指定の本文をそのまま見せる）。
   もとの用途カード3枚（食材集め/水切り/掃除サポート）は、この3点と内容が重なるため置き換えた。
   丸カードの視覚リズムは残しつつ、指定文をそのまま読ませたいので横並びの3枚組にしている。 */
.lp-wrapper #sec-scraper .sc-lead-in{ font-size: var(--fs-body); line-height: 2.05; color: var(--text); margin-bottom: 18px; }
.lp-wrapper #sec-scraper .sc-points{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 40px; }
.lp-wrapper #sec-scraper .sc-point{ background: #fff; border-radius: var(--radius-card); padding: 24px 22px; display: flex; flex-direction: column; gap: 12px; }
.lp-wrapper #sec-scraper .sc-point svg{ width: 24px; height: 24px; color: var(--green); flex-shrink: 0; }
.lp-wrapper #sec-scraper .sc-point p{ font-size: var(--fs-note); line-height: 1.9; color: var(--text); }
.lp-wrapper #sec-scraper .sc-close{ font-size: var(--fs-lead); font-weight: 700; line-height: 1.95; color: var(--navy); }
/* 締めのフルブリード映像（まな板の使用シーン・スクロールの山場） */
.lp-wrapper #sec-scraper .sc-outro{ margin-top: 88px; }
.lp-wrapper #sec-scraper .sc-outro h3{ font-size: var(--fs-h2); font-weight: 400; line-height: 1.5; letter-spacing: .02em; color: var(--navy); text-align: center; margin-bottom: 40px; }
.lp-wrapper #sec-scraper .sc-outro-media{ width: 100%; overflow: hidden; }
.lp-wrapper #sec-scraper .sc-outro-media video{ width: 100%; display: block; }
@media (max-width: 768px) {
  .lp-wrapper #sec-scraper .sc-media{ margin-bottom: 34px; }
  .lp-wrapper #sec-scraper .sc-points{ grid-template-columns: 1fr; gap: 12px; margin-bottom: 32px; }
  .lp-wrapper #sec-scraper .sc-point{ flex-direction: row; align-items: flex-start; padding: 20px 18px; }
  .lp-wrapper #sec-scraper .sc-outro{ margin-top: 60px; }
  .lp-wrapper #sec-scraper .sc-outro h3{ margin-bottom: 26px; }
}

/* ================== 4. sec-flow（お申し込みの流れ・STEP1=販路別4枠／STEP2） ==================
   下敷き: howto/商流2使い方_写真3ステップ型（番号バッジ＋ステップの組み）
          ＋ compatible/商流2これ1台_実写真カード型（同型カードを横並びにして「自分の該当」を探させる）
   規約: 4枠は同じ大きさ・同じ高さ・同じ位置とし、
        差はボタンの見た目だけ（他3枠＝枠線ボタン／Amazon枠＝チェック＋塗りボタン）。 */
.lp-wrapper #sec-flow{ background: var(--bg-white); }
.lp-wrapper #sec-flow h2{ margin-bottom: 48px; }
.lp-wrapper #sec-flow .fl-step{ margin-bottom: 26px; }
.lp-wrapper #sec-flow .fl-step-head{ display: flex; align-items: center; gap: 16px; margin-bottom: 12px; }
.lp-wrapper #sec-flow .fl-num{ display: inline-flex; align-items: center; justify-content: center; height: 36px; padding: 0 16px; border-radius: var(--radius-pill); background: var(--wine); color: #fff; font-size: var(--fs-micro); font-weight: 700; letter-spacing: .1em; flex-shrink: 0; }
.lp-wrapper #sec-flow .fl-step-head h3{ font-family: "Zen Kaku Gothic New", sans-serif; font-size: var(--fs-lead); font-weight: 700; color: var(--navy); line-height: 1.6; }
.lp-wrapper #sec-flow .fl-step-note{ font-size: var(--fs-note); line-height: 1.95; color: var(--text-sub); }
/* 販路4枠 */
/* 2026-08-04 市山さん指示: PCは2カラム（2×2）。カード幅が広がり、ピル・ボタンが1行に収まる */
.lp-wrapper #sec-flow .fl-shops{ display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin: 30px 0 64px; align-items: stretch; }
.lp-wrapper #sec-flow .shop{ background: #fff; border: 1px solid var(--line); border-top: 6px solid var(--shop-color, var(--navy)); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; box-shadow: var(--shadow-card); }
.lp-wrapper #sec-flow .shop.is-rakuten{ --shop-color: var(--c-rakuten); }
.lp-wrapper #sec-flow .shop.is-official{ --shop-color: var(--c-official); }
.lp-wrapper #sec-flow .shop.is-yahoo{ --shop-color: var(--c-yahoo); }
.lp-wrapper #sec-flow .shop.is-amazon{ --shop-color: var(--c-amazon); }
/* ロゴ面（自社ストアCDN上の既存画像をURL参照。ダウンロード・再保存はしない）
   ※ 元画像は下部に「◯◯で購入 ➡」の文字が焼き込まれた購入バナーのため、上部のロゴだけを
     切り出して表示する（申込フローの中に「購入」の導線を出さないため）。
