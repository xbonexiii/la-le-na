<!-- MOBILE STICKY CTA -->
<div id="lcr-sticky-cta">
  <a href="https://lin.ee/rDDhEF8">▼ LINEで次回の再販案内を受け取る</a>
  <p class="sticky-note">次回の再販・セールをLINEで先行案内</p>
