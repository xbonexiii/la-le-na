<style>
  /* ============================================================
     CSS 変数 / フォント定義
  ============================================================ */
  /* フォント変数はLP内にスコープ（:root だとテーマ全体=ヘッダーのフォントを上書きしてしまうため） */
  .lcr-wrap, .rp-wrap, #sec-11reasons, .hs-lp-modal-overlay {
    --font-body-family: 'Zen Kaku Gothic New', sans-serif;
    --font-heading-family: 'Noto Serif JP', serif;
  }

  /* ============================================================
     ページ幅クラス（LP専用・テーマの .page-width と衝突させない）
  ============================================================ */
  .lcr-page-width {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }
  @media (max-width: 768px) {
    .lcr-page-width { padding: 0 20px; }
  }
  .lcr-h0 { font-size: clamp(32px, 4.5vw, 56px); font-weight: 700; }
  .lcr-h1 { font-size: clamp(28px, 4vw, 48px); font-weight: 700; }
  .lcr-h2 { font-size: clamp(26px, 3.5vw, 42px); font-weight: 700; }

  /* ============================================================
     lcr-wrap — Reset / Base
  ============================================================ */
  .lcr-wrap *, .lcr-wrap *::before, .lcr-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .lcr-wrap {
    font-family: var(--font-body-family);
    color: #1d1d1f;
    font-size: 17px;
    line-height: 1.7;
    overflow-x: hidden;
  }
  .lcr-wrap img { max-width: 100%; height: auto; display: block; }
  .lcr-wrap a { color: inherit; text-decoration: none; }

  /* ---- Design Tokens ---- */
  .lcr-wrap {
    --gold: #C9AC82;
    --gold-light: #d8c09a;
    --wine: #6E1F2E;
    --navy: #202124;
    --text: #1d1d1f;
    --bg-white: #ffffff;
    --bg-gray: #f5f5f7;
    --bg-cream: #F5EFE6;
    --bg-dark: #202124;
    --line-green: #06C755;
    --line-green-hover: #04a847;
  }

  /* ---- Layout ---- */
  .lcr-wrap section { width: 100%; }
  .lcr-wrap .container { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .lcr-wrap .section-padding { padding: 100px 0; }

  /* ---- Typography ---- */
  .lcr-wrap h2.section-title {
    font-size: clamp(26px, 3.5vw, 42px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* ---- Animations ---- */
  .lcr-wrap .fade-in {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .lcr-wrap .fade-in.visible { opacity: 1; transform: translateY(0); }
  .lcr-wrap .slide-left  { opacity: 0; transform: translateX(-48px); transition: opacity 0.8s ease, transform 0.8s ease; }
  .lcr-wrap .slide-right { opacity: 0; transform: translateX(48px);  transition: opacity 0.8s ease, transform 0.8s ease; }
  .lcr-wrap .slide-up    { opacity: 0; transform: translateY(32px);  transition: opacity 0.7s ease, transform 0.7s ease; }
  .lcr-wrap .slide-left.visible, .lcr-wrap .slide-right.visible, .lcr-wrap .slide-up.visible { opacity: 1; transform: none; }

  /* ---- Buttons ---- */
  .lcr-wrap .btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--gold); color: #fff;
    font-size: 18px; font-weight: 700;
    padding: 18px 40px; border-radius: 50px;
    cursor: pointer; transition: background 0.2s, transform 0.1s;
    border: none; letter-spacing: 0.02em;
  }
  .lcr-wrap .btn-primary:hover { background: var(--gold-light); transform: translateY(-1px); }
  .lcr-wrap .btn-line {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--line-green); color: #fff;
    font-size: 18px; font-weight: 700;
    padding: 18px 40px; border-radius: 50px;
    cursor: pointer; transition: background 0.2s, transform 0.1s;
    border: none; letter-spacing: 0.02em; text-decoration: none;
  }
  .lcr-wrap .btn-line:hover { background: var(--line-green-hover); transform: translateY(-1px); }
  .lcr-wrap .btn-line svg { width: 24px; height: 24px; flex-shrink: 0; }
  @media (max-width: 768px) {
    .lcr-wrap .btn-line {
      font-size: 15px;
      padding: 14px 20px;
      white-space: normal;
      line-height: 1.4;
      text-align: center;
      gap: 8px;
    }
    .lcr-wrap .btn-line svg { width: 20px; height: 20px; }
  }

  /* ---- Scroll Hint ---- */
  .lcr-wrap .scroll-hint {
    position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    color: rgba(255,255,255,0.55); font-size: 10px; letter-spacing: 0.15em;
    text-transform: uppercase; animation: lcr-scroll-bounce 2.2s infinite; cursor: default;
  }
  .lcr-wrap .scroll-hint svg { width: 20px; height: 20px; }
  @keyframes lcr-scroll-bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.55; }
    50%       { transform: translateX(-50%) translateY(8px); opacity: 0.9; }
  }

  /* ---- Middle CTA ---- */
  .lcr-wrap #sec-cta-mid {
    background: var(--bg-dark); color: #fff;
    padding: 72px 0; text-align: center;
  }
  .lcr-wrap #sec-cta-mid .mid-cta-inner { max-width: 560px; margin: 0 auto; }
  .lcr-wrap #sec-cta-mid .mid-cta-title {
    font-size: 28px; font-weight: 700; line-height: 1.4;
    margin-bottom: 12px; letter-spacing: -0.02em; color: #fff;
  }
  .lcr-wrap #sec-cta-mid .mid-cta-sub { font-size: 15px; opacity: 0.75; margin-bottom: 32px; }
  .lcr-wrap #sec-cta-mid .btn-line { font-size: 17px; }
  .lcr-wrap #sec-cta-mid .mid-cta-note { font-size: 13px; opacity: 0.6; margin-top: 12px; }
  @media (max-width: 768px) {
    .lcr-wrap #sec-cta-mid { padding: 56px 0; }
    .lcr-wrap #sec-cta-mid .mid-cta-title { font-size: 22px; }
  }

  /* ---- Mobile Sticky CTA ---- */
  #lcr-sticky-cta {
    display: none;
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 8000;
    padding: 8px 20px 12px;
    background: rgba(255,255,255,0.97);
    border-top: 1px solid #e5e5ea;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.35s ease, transform 0.35s ease;
    pointer-events: none;
  }
  #lcr-sticky-cta.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  #lcr-sticky-cta a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    width: 100%;
    background: #06C755;
    color: #fff;
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 16px;
    border-radius: 12px;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
  }
  #lcr-sticky-cta a svg { width: 20px; height: 20px; flex-shrink: 0; }
  @media (max-width: 374px) {
    #lcr-sticky-cta a { font-size: 13px; gap: 6px; }
    #lcr-sticky-cta a svg { width: 18px; height: 18px; }
  }
  #lcr-sticky-cta-label {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-size: 16px;
    color: #1d1d1f;
    font-weight: 700;
    text-align: center;
    margin-bottom: 8px;
  }
  @media (min-width: 769px) { #lcr-sticky-cta { display: none !important; } }

  /* ---- Parallax BG ---- */
  .lcr-wrap .parallax-bg {
    top: -15% !important; bottom: auto !important; height: 130% !important; will-change: transform;
  }
  @media (max-width: 768px) {
    .lcr-wrap .parallax-bg { top: 0 !important; height: 100% !important; will-change: auto; }
  }

  /* ============================================================
     SEC-HERO
  ============================================================ */
  .lcr-wrap #sec-hero {
    position: relative; min-height: 90vh;
    display: flex; align-items: center; overflow: hidden; background: #202124;
  }
  .lcr-wrap #sec-hero .hero-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center; opacity: 0.6;
  }
  .lcr-wrap #sec-hero .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.72) 40%, rgba(0,0,0,0.3) 100%);
  }
  .lcr-wrap #sec-hero .container { position: relative; z-index: 1; }
  .lcr-wrap #sec-hero .eyebrow {
    font-size: 13px; font-weight: 500; letter-spacing: 0.15em;
    color: var(--gold); text-transform: uppercase; margin-bottom: 20px;
  }
  .lcr-wrap #sec-hero h1 {
    font-size: clamp(32px, 5vw, 60px); font-weight: 700; color: #fff;
    line-height: 1.25; margin-bottom: 24px; font-family: var(--font-heading-family);
  }
  .lcr-wrap #sec-hero .subheadline {
    font-size: 18px; color: rgba(255,255,255,0.88);
    margin-bottom: 40px; line-height: 1.7; max-width: 560px;
  }
  .lcr-wrap #sec-hero .cta-note { font-size: 13px; color: rgba(255,255,255,0.65); margin-top: 16px; }
  /* Hero ライブバッジ（セール開催中を目立たせる・点滅ドット付き） */
  .lcr-wrap #sec-hero .hero-live-badge {
    display: inline-flex; align-items: center; gap: 9px;
    background: var(--wine); color: #fff;
    font-size: 15px; font-weight: 700; letter-spacing: 0.08em;
    padding: 9px 20px; border-radius: 50px; margin-bottom: 18px;
    box-shadow: 0 6px 20px rgba(110,31,46,0.45);
  }
  .lcr-wrap #sec-hero .hero-live-badge .live-dot {
    width: 10px; height: 10px; border-radius: 50%; background: #fff;
    animation: lcr-live-pulse 1.5s ease-out infinite;
  }
  @keyframes lcr-live-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(255,255,255,0.7); }
    70%  { box-shadow: 0 0 0 11px rgba(255,255,255,0); }
    100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lcr-wrap #sec-hero .hero-live-badge .live-dot { animation: none; }
  }
  @media (max-width: 768px) {
    .lcr-wrap #sec-hero .hero-live-badge { font-size: 13.5px; padding: 8px 16px; }
  }
  /* Hero 緊急バッジ（割引が短期間・登録しないと逃すことを端的に強調） */
  .lcr-wrap #sec-hero .hero-urgency {
    display: inline-flex; align-items: center; gap: 10px;
    background: rgba(201,172,130,0.16); border: 1px solid var(--gold);
    border-radius: 12px; padding: 12px 18px; margin-bottom: 28px;
    max-width: 560px;
  }
  .lcr-wrap #sec-hero .hero-urgency svg { width: 22px; height: 22px; flex-shrink: 0; color: var(--gold); }
  .lcr-wrap #sec-hero .hero-urgency .urg-text {
    font-size: 15px; font-weight: 700; color: #fff; line-height: 1.5; text-align: left;
  }
  .lcr-wrap #sec-hero .hero-urgency .urg-text strong { color: var(--gold); }
  @media (max-width: 768px) {
    .lcr-wrap #sec-hero .hero-urgency { padding: 11px 14px; gap: 8px; }
    .lcr-wrap #sec-hero .hero-urgency .urg-text { font-size: 13.5px; }
  }
  /* Hero カウントダウン（終了 6/19 23:59 まで） */
  .lcr-wrap #sec-hero .hero-countdown { margin-bottom: 28px; max-width: 560px; }
  .lcr-wrap #sec-hero .countdown-label {
    font-size: 13px; font-weight: 700; letter-spacing: 0.08em;
    color: var(--gold); margin-bottom: 10px;
  }
  .lcr-wrap #sec-hero .countdown-timer { display: flex; gap: 10px; }
  .lcr-wrap #sec-hero .cd-unit {
    flex: 1; max-width: 84px; text-align: center;
    background: rgba(0,0,0,0.35); border: 1px solid rgba(201,172,130,0.45);
    border-radius: 10px; padding: 10px 6px;
  }
  .lcr-wrap #sec-hero .cd-num {
    font-size: 30px; font-weight: 700; color: #fff; line-height: 1.1;
    font-variant-numeric: tabular-nums; letter-spacing: 0.02em;
  }
  .lcr-wrap #sec-hero .cd-cap { font-size: 11px; color: rgba(255,255,255,0.7); margin-top: 4px; }
  .lcr-wrap #sec-hero .countdown-ended {
    font-size: 15px; font-weight: 700; color: #fff;
    background: rgba(0,0,0,0.35); border: 1px solid rgba(201,172,130,0.45);
    border-radius: 10px; padding: 14px 18px;
  }
  @media (max-width: 768px) {
    .lcr-wrap #sec-hero .countdown-timer { gap: 7px; }
    .lcr-wrap #sec-hero .cd-unit { padding: 8px 4px; }
    .lcr-wrap #sec-hero .cd-num { font-size: 24px; }
    .lcr-wrap #sec-hero .cd-cap { font-size: 10px; }
  }
  /* Hero 信頼バー（広告流入の冷たい層を最初の画面で掴む） */
  .lcr-wrap #sec-hero .hero-proof {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px 18px; margin-bottom: 28px;
  }
  .lcr-wrap #sec-hero .hero-proof .proof-stars {
    display: inline-flex; align-items: center; gap: 8px; color: #fff; font-size: 15px;
  }
  .lcr-wrap #sec-hero .hero-proof .stars { color: #f5c518; letter-spacing: 2px; font-size: 17px; }
  .lcr-wrap #sec-hero .hero-proof .proof-badge {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--gold); font-size: 14px; font-weight: 700;
    border: 1px solid rgba(201,172,130,0.55); border-radius: 50px; padding: 4px 14px;
  }
  @media (max-width: 768px) {
    .lcr-wrap #sec-hero .hero-proof { gap: 8px 12px; margin-bottom: 24px; }
    .lcr-wrap #sec-hero .hero-proof .proof-stars { font-size: 13px; }
    .lcr-wrap #sec-hero .hero-proof .stars { font-size: 15px; }
    .lcr-wrap #sec-hero .hero-proof .proof-badge { font-size: 12px; padding: 3px 12px; }
  }

  /* SEC-LINE-BENEFITS（登録メリット要約バンド：ヒーロー直後） */
  .lcr-wrap #sec-line-benefits { background: var(--bg-cream); padding: 48px 0; }
  .lcr-wrap #sec-line-benefits .band-label {
    text-align: center; font-weight: 700; font-size: 18px; margin-bottom: 28px;
    font-family: var(--font-heading-family);
  }
  .lcr-wrap #sec-line-benefits .band-label strong { color: var(--line-green); }
  .lcr-wrap #sec-line-benefits .band-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 32px;
  }
  .lcr-wrap #sec-line-benefits .band-item {
    display: flex; gap: 14px; align-items: flex-start;
    background: #fff; border-radius: 14px; padding: 22px;
  }
  .lcr-wrap #sec-line-benefits .bi-icon {
    flex-shrink: 0; width: 42px; height: 42px; border-radius: 50%;
    background: rgba(201,172,130,0.15); color: var(--gold);
    display: flex; align-items: center; justify-content: center;
  }
  .lcr-wrap #sec-line-benefits .bi-icon svg { width: 22px; height: 22px; }
  .lcr-wrap #sec-line-benefits .bi-title { font-weight: 700; font-size: 15px; margin-bottom: 4px; line-height: 1.4; }
  .lcr-wrap #sec-line-benefits .bi-body { font-size: 13px; color: #6e6e73; line-height: 1.6; }
  .lcr-wrap #sec-line-benefits .band-cta { text-align: center; }
  .lcr-wrap #sec-line-benefits .band-note { text-align: center; font-size: 13px; color: #6e6e73; margin-top: 14px; }
  @media (max-width: 768px) {
    .lcr-wrap #sec-line-benefits { padding: 40px 0; }
    .lcr-wrap #sec-line-benefits .band-grid { grid-template-columns: 1fr; gap: 12px; }
    .lcr-wrap #sec-line-benefits .band-item { padding: 16px; }
  }

  /* ============================================================
     SEC-STORY / SEC-VIDEO / SEC-RANKING / SEC-REVIEWS（非表示）
  ============================================================ */
  .lcr-wrap #sec-story { display: none; }
  .lcr-wrap #sec-video { display: none; }
  .lcr-wrap #sec-ranking { display: none; }
  .lcr-wrap #sec-reviews { display: none; }
  #sec-11reasons { display: none; }

  /* ---- Story ---- */
  .lcr-wrap #sec-story .story-inner {
    display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center;
  }
  .lcr-wrap #sec-story .section-title { margin-bottom: 28px; }
  .lcr-wrap #sec-story .story-quote {
    font-size: 17px; font-style: italic; color: #3a3a3a;
    border-left: 3px solid var(--gold); padding-left: 20px;
    margin-bottom: 32px; line-height: 1.8;
  }
  .lcr-wrap #sec-story .story-stats { display: flex; gap: 32px; margin-bottom: 32px; flex-wrap: wrap; }
  .lcr-wrap #sec-story .stat-item { text-align: center; }
  .lcr-wrap #sec-story .stat-number { font-size: 48px; font-weight: 700; color: var(--wine); line-height: 1; letter-spacing: -0.03em; }
  .lcr-wrap #sec-story .stat-unit { font-size: 18px; font-weight: 700; color: var(--wine); }
  .lcr-wrap #sec-story .stat-label { font-size: 13px; color: #6e6e73; margin-top: 4px; }
  .lcr-wrap #sec-story .story-body { font-size: 17px; line-height: 2; color: #3a3a3a; }
  .lcr-wrap #sec-story .story-body p + p { margin-top: 16px; }
  .lcr-wrap #sec-story .story-image-wrap { border-radius: 20px; overflow: hidden; }
  .lcr-wrap #sec-story .story-image-wrap img { width: 100%; height: 520px; object-fit: cover; display: block; }

  /* ---- Reviews ---- */
  .lcr-wrap #sec-reviews { background: #FEF9ED; }
  .lcr-wrap #sec-reviews .reviews-hero-wrap {
    position: relative; width: 100%; margin: 0 0 64px;
    aspect-ratio: 16 / 9; overflow: hidden; border-radius: 20px;
  }
  .lcr-wrap #sec-reviews .reviews-hero-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lcr-wrap #sec-reviews .reviews-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.55));
    display: flex; align-items: flex-end; padding: 32px 40px;
  }
  .lcr-wrap #sec-reviews .reviews-hero-label { color: #fff; font-size: 20px; font-weight: 700; }
  .lcr-wrap #sec-reviews .section-title { text-align: center; margin-bottom: 48px; }

  /* ============================================================
     SEC-SALE
  ============================================================ */
  .lcr-wrap #sec-sale { background: var(--bg-white); }
  .lcr-wrap #sec-sale .sale-inner {
    display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center;
  }
  .lcr-wrap #sec-sale .section-title { margin-bottom: 32px; }
  .lcr-wrap #sec-sale .sale-table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .lcr-wrap #sec-sale .sale-table tr { border-bottom: 1px solid #e8e8e8; }
  .lcr-wrap #sec-sale .sale-table tr:first-child { border-top: 1px solid #e8e8e8; }
  .lcr-wrap #sec-sale .sale-table th {
    text-align: left; font-weight: 600; color: #6e6e73;
    padding: 16px 16px 16px 0; white-space: nowrap; vertical-align: top; width: 120px;
  }
  .lcr-wrap #sec-sale .sale-table td { padding: 16px 0; color: #1d1d1f; line-height: 1.6; }
  .lcr-wrap #sec-sale .sale-table .price-highlight { font-size: 17px; font-weight: 700; color: var(--wine); }
  .lcr-wrap #sec-sale .sale-image-wrap { border-radius: 20px; overflow: hidden; }
  .lcr-wrap #sec-sale .sale-image-wrap img { width: 100%; height: 520px; object-fit: cover; display: block; }
  .lcr-wrap #sec-sale .sale-cta-wrap { margin-top: 36px; }

  /* ============================================================
     SEC-LINE
  ============================================================ */
  .lcr-wrap #sec-line { background: var(--bg-gray); }
  .lcr-wrap #sec-line .section-title { text-align: center; margin-bottom: 16px; }
  .lcr-wrap #sec-line .line-subtitle { text-align: center; color: #6e6e73; margin-bottom: 56px; font-size: 17px; }
  .lcr-wrap #sec-line .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 56px; }
  .lcr-wrap #sec-line .step-card { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 2px 20px rgba(0,0,0,0.06); }
  .lcr-wrap #sec-line .step-image-wrap img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block; }
  .lcr-wrap #sec-line .step-content { padding: 24px; }
  .lcr-wrap #sec-line .step-number { font-size: 12px; font-weight: 700; letter-spacing: 0.15em; color: var(--gold); text-transform: uppercase; margin-bottom: 8px; }
  .lcr-wrap #sec-line .step-title { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
  .lcr-wrap #sec-line .step-body { font-size: 15px; color: #6e6e73; line-height: 1.7; }
  .lcr-wrap #sec-line .line-merits { background: #fff; border-radius: 16px; padding: 36px 40px; margin-bottom: 36px; max-width: 720px; margin-left: auto; margin-right: auto; }
  .lcr-wrap #sec-line .line-merits-title { font-size: 18px; font-weight: 700; margin-bottom: 20px; color: var(--text); }
  .lcr-wrap #sec-line .merit-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .lcr-wrap #sec-line .merit-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; color: #3a3a3a; line-height: 1.6; }
  .lcr-wrap #sec-line .merit-icon { flex-shrink: 0; width: 22px; height: 22px; background: var(--line-green); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: 2px; }
  .lcr-wrap #sec-line .merit-icon svg { width: 14px; height: 14px; }
  .lcr-wrap #sec-line .line-note { text-align: center; font-size: 14px; color: #6e6e73; margin-bottom: 36px; }
  .lcr-wrap #sec-line .line-cta-wrap { text-align: center; }

  /* ============================================================
     SEC-CTA（最終CTA）
  ============================================================ */
  .lcr-wrap #sec-cta { background: var(--bg-dark); color: #fff; position: relative; overflow: hidden; }
  .lcr-wrap #sec-cta .cta-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.15; }
  .lcr-wrap #sec-cta .container { position: relative; z-index: 1; text-align: center; }
  .lcr-wrap #sec-cta .section-title { color: #fff; margin-bottom: 16px; font-size: clamp(28px, 4vw, 48px); }
  .lcr-wrap #sec-cta .cta-sub { font-size: 17px; color: rgba(255,255,255,0.75); margin-bottom: 48px; }
  .lcr-wrap #sec-cta .btn-line { font-size: 20px; padding: 22px 52px; }
  .lcr-wrap #sec-cta .cta-note { font-size: 13px; color: rgba(255,255,255,0.45); margin-top: 20px; }

  /* ============================================================
     SEC-VIDEO / SEC-RANKING（非表示のため最小CSS）
  ============================================================ */
  .lcr-wrap #sec-video { background: var(--bg-white); }
  .lcr-wrap #sec-video .video-wrap { position: relative; max-width: 860px; margin: 0 auto; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 48px rgba(0,0,0,0.12); aspect-ratio: 16 / 9; }
  .lcr-wrap #sec-video .video-wrap video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; display: block; object-fit: cover; }
  .lcr-wrap #sec-ranking { background: #FEF9ED; color: #1d1d1f; position: relative; overflow: hidden; }
  .lcr-wrap #sec-ranking .badges-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px 28px; max-width: 960px; margin: 0 auto; }
  .lcr-wrap #sec-ranking .badge-item { display: flex; align-items: center; justify-content: center; padding: 8px 4px; }
  .lcr-wrap #sec-ranking .badge-item img { width: 100%; max-width: 280px; height: auto; display: block; margin: 0 auto; }
  @keyframes ralena-glow-pulse {
    0%, 100% { filter: drop-shadow(0 4px 24px rgba(201,172,130,0.5)); }
    50%       { filter: drop-shadow(0 4px 36px rgba(201,172,130,0.75)); }
  }

  /* ============================================================
     Horizontal Scroll LP（11の理由）
  ============================================================ */
  .hs-lp-features-11-reasons-padding { padding-top: 60px; padding-bottom: 36px; overflow: hidden; position: relative; }
  .hs-lp-features-11-reasons-title-wrapper { max-width: 1200px; margin: 0 auto; padding: 0 20px; margin-bottom: 32px; text-align: center; }
  .hs-lp-features-11-reasons-title-wrapper h2 { font-size: clamp(26px, 3.5vw, 42px); font-weight: 700; line-height: 1.3; letter-spacing: -0.01em; margin-bottom: 12px; }
  .hs-lp-features-11-reasons-subtitle { font-size: 15px; font-weight: 400; color: #6e6e73; margin-top: 0; line-height: 1.8; }
  .hs-lp-features-11-reasons-scroll { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 20px; padding: 10px; scroll-padding-left: 10px; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .hs-lp-features-11-reasons-scroll::-webkit-scrollbar { display: none; }
  .hs-lp-features-11-reasons-card { display: block; position: relative; scroll-snap-align: start; flex: 0 0 auto; width: 400px; height: 600px; border-radius: 16px; overflow: hidden; background-size: cover; background-position: center; background-repeat: no-repeat; background-color: #000; color: #fff; cursor: pointer; will-change: transform; transition: transform 0.3s ease, box-shadow 0.3s ease; border: none; outline: none; text-align: left; }
  .hs-lp-features-11-reasons-card:hover { transform: scale(1.02); box-shadow: 0 8px 32px rgba(0,0,0,0.25); }
  .hs-lp-features-11-reasons-card-inner { width: 100%; height: 100%; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.55) 100%); }
  .hs-lp-features-11-reasons-caption { font-size: 12px; opacity: 0.85; font-weight: 700; margin: 0; letter-spacing: 0.1em; }
  .hs-lp-features-11-reasons-heading { font-size: 24px; font-weight: bold; margin: 5px 0 0; line-height: 1.4; }
  .hs-lp-features-11-reasons-text { font-size: 16px; margin: 8px 0 0; line-height: 1.5; opacity: 0.85; }
  .hs-lp-features-11-reasons-hint { position: absolute; bottom: 16px; right: 16px; width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.5); display: flex; align-items: center; justify-content: center; font-size: 16px; color: #fff; }
  .hs-lp-features-11-reasons-nav { position: absolute; bottom: 20px; right: 20px; display: flex; gap: 10px; }
  .hs-lp-features-11-reasons-nav button { width: 40px; height: 40px; border-radius: 50%; background: white; border: none; display: flex; align-items: center; justify-content: center; box-shadow: 0 1px 5px rgba(0,0,0,0.15); cursor: pointer; transition: background 0.2s; }
  .hs-lp-features-11-reasons-nav button:hover { background: #d6d6d7; }
  .hs-lp-features-11-reasons-nav svg { width: 20px; height: 20px; fill: #333; }

  /* Modal */
  .hs-lp-modal-overlay { display: none; position: fixed; inset: 0; z-index: 9000; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); align-items: center; justify-content: center; padding: 20px; }
  .hs-lp-modal-overlay.is-open { display: flex; animation: hs-modal-fade-in 0.2s ease; }
  @keyframes hs-modal-fade-in { from { opacity: 0; } to { opacity: 1; } }
  .hs-lp-modal { background: #fff; border-radius: 20px; max-width: 560px; width: 100%; max-height: 88vh; overflow-y: auto; position: relative; box-shadow: 0 24px 80px rgba(0,0,0,0.3); animation: hs-modal-slide-up 0.25s ease; }
  @keyframes hs-modal-slide-up { from { transform: translateY(24px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  .hs-lp-modal-close { position: absolute; top: 16px; right: 16px; z-index: 1; width: 36px; height: 36px; border-radius: 50%; background: rgba(0,0,0,0.55); border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 20px; line-height: 1; transition: background 0.2s; }
  .hs-lp-modal-close:hover { background: rgba(0,0,0,0.8); }
  .hs-lp-modal-image-wrap { width: 100%; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 20px 20px 0 0; }
  .hs-lp-modal-image-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hs-lp-modal-body { padding: 28px 32px 36px; }
  .hs-lp-modal-caption { font-size: 12px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #9a7a4a; margin-bottom: 8px; }
  .hs-lp-modal-heading { font-size: 26px; font-weight: 700; color: #1d1d1f; line-height: 1.35; margin-bottom: 8px; }
  .hs-lp-modal-subtext { font-size: 15px; font-weight: 600; color: #3a3a3a; margin-bottom: 16px; }
  .hs-lp-modal-detail { font-size: 15px; color: #6e6e73; line-height: 1.8; }

  /* ============================================================
     Responsive
  ============================================================ */
  @media (max-width: 900px) {
    .lcr-wrap #sec-ranking .badges-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }
  @media (max-width: 768px) {
    .lcr-wrap { font-size: 16px; }
    .lcr-wrap .container { padding: 0 20px; }
    .lcr-wrap .section-padding { padding: 64px 0; }
    .lcr-wrap h2.section-title { font-size: 28px; }
    .lcr-wrap #sec-hero { min-height: 85vh; }
    .lcr-wrap #sec-hero .container { padding-left: 24px; padding-right: 24px; }
    .lcr-wrap #sec-hero h1 { font-size: 28px; }
    .lcr-wrap #sec-hero .subheadline { font-size: 15px; }
    .lcr-wrap #sec-story .story-inner { grid-template-columns: 1fr; gap: 40px; }
    .lcr-wrap #sec-story .story-image-wrap img { height: 300px; }
    .lcr-wrap #sec-story .story-stats { gap: 20px; }
    .lcr-wrap #sec-story .stat-number { font-size: 36px; }
    .lcr-wrap #sec-reviews .reviews-hero-wrap { margin-bottom: 40px; }
    .lcr-wrap #sec-sale .sale-inner { grid-template-columns: 1fr; gap: 40px; }
    .lcr-wrap #sec-sale .sale-image-wrap { order: -1; }
    .lcr-wrap #sec-sale .sale-image-wrap img { height: 280px; }
    .lcr-wrap #sec-line .steps { grid-template-columns: 1fr; }
    .lcr-wrap #sec-line .line-merits { padding: 28px 24px; }
    .lcr-wrap #sec-cta .btn-line { font-size: 16px; padding: 18px 32px; width: 100%; justify-content: center; }
    .lcr-wrap .btn-line { width: 100%; justify-content: center; }
    .hs-lp-features-11-reasons-title-wrapper { text-align: left; }
    .hs-lp-features-11-reasons-title-wrapper h2 { font-size: 28px; }
    .hs-lp-features-11-reasons-card { width: min(400px, 80vw); }
    .hs-lp-modal { border-radius: 16px; max-height: 92vh; }
    .hs-lp-modal-image-wrap { border-radius: 16px 16px 0 0; }
    .hs-lp-modal-body { padding: 20px 20px 28px; }
    .hs-lp-modal-heading { font-size: 22px; }
  }
  @media (max-width: 480px) {
    .lcr-wrap #sec-ranking .badges-grid { grid-template-columns: 1fr; }
  }

  /* ============================================================
     PRODUCT PAGE SECTIONS (rp-wrap)
  ============================================================ */
  .rp-wrap {
    font-family: var(--font-body-family, 'Zen Kaku Gothic New', sans-serif);
    color: #1d1d1f;
    background: #fef9ed;
  }
  .rp-wrap *, .rp-wrap *::before, .rp-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }
  .rp-wrap img { max-width: 100%; height: auto; display: block; }
  .rp-wrap a { color: inherit; text-decoration: none; }
  .rp-wrap section { width: 100%; }
  .rp-container { max-width: 820px; margin: 0 auto; padding: 0 40px; }
  .rp-wrap .rp-full-img { width: 100%; max-width: 820px; margin: 0 auto; display: block; }
  @media (max-width: 768px) {
    .rp-container { padding: 0 20px; }
    .rp-wrap .rp-full-img { max-width: 100%; }
  }

  /* ---- 右下固定バナー（PC専用） ---- */
  #pc-fixed-banner {
    display: none;
    position: fixed;
    bottom: 32px; right: 32px;
    z-index: 9000;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
  }
  #pc-fixed-banner.visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
  #pc-fixed-banner img { width: 240px; height: auto; display: block; border-radius: 8px; box-shadow: 0 8px 32px rgba(0,0,0,0.18); }
  #pc-fixed-banner-close {
    position: absolute; top: -10px; right: -10px;
    width: 24px; height: 24px;
    background: #1d1d1f; color: #fff;
    border: none; border-radius: 50%; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; line-height: 1; padding: 0;
  }
  @media (max-width: 768px) { #pc-fixed-banner { display: none !important; } }
</style>


