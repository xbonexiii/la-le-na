<!-- ============ モバイルスティッキー（UGC転用：投稿導線へ誘導） ============ -->
<div id="sticky-cta">
  <a href="#post">#ラレーナのある暮らし で教える ▼</a>
  <p class="sticky-note">スマホの写真1枚＋ひとことでOK・特典なしの自発投稿です</p>
</div>

<!-- ============ scripts.js（library/土台・インライン内包）＋スティッキー制御 ============ -->
<script>
/* ① スライドイン／フェードイン発火（IntersectionObserver） */
(function () {
  var targets = document.querySelectorAll('.slide-left, .slide-right, .slide-up, .fade-in');
  if (!('IntersectionObserver' in window)) { targets.forEach(function (el) { el.classList.add('visible'); }); return; }
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold: 0.15 });
  targets.forEach(function (el) { obs.observe(el); });
})();
/* ② モバイルスティッキー制御（sec-solution通過で出現・sec-cta表示中は隠す・上スクロールで凹む） */
(function () {
  var el = document.getElementById('sticky-cta'); if (!el) return;
  var shown = false; var lastY = window.scrollY;
  window.addEventListener('scroll', function () {
    var y = window.scrollY;
    if (shown) { if (y < lastY - 4) el.classList.add('retract'); else if (y > lastY + 4) el.classList.remove('retract'); }
    lastY = y;
  }, { passive: true });
  var trigger = document.getElementById('sec-solution');
  if (trigger && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (!e.isIntersecting && !shown && window.scrollY > trigger.offsetTop) { el.style.display = 'block'; shown = true; } });
    }, { threshold: 0 }).observe(trigger);
  }
  var finalCta = document.getElementById('sec-cta');
  if (finalCta && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { el.style.display = e.isIntersecting ? 'none' : (shown ? 'block' : 'none'); });
    }, { threshold: 0.1 }).observe(finalCta);
  }
})();

/* ③ 横スクロールカードの左右矢印スクロール */
(function () {
  var sc = document.querySelector('#sec-features .ft-scroller');
  if (!sc) return;
  function step() { var c = sc.querySelector('.hcard'); return (c ? c.getBoundingClientRect().width : 340) + 16; }
  var prev = document.querySelector('#sec-features .ft-prev');
  var next = document.querySelector('#sec-features .ft-next');
  if (prev) prev.addEventListener('click', function () { sc.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function () { sc.scrollBy({ left: step(), behavior: 'smooth' }); });
})();

/* ④ 投稿例・テンプレ見本文のワンタップコピー */
(function () {
  var COPY_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
  var CHECK_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

  function fallbackCopy(text, done) {
    var ta = document.createElement('textarea');
    ta.value = text; ta.setAttribute('readonly', '');
    ta.style.position = 'fixed'; ta.style.left = '-9999px'; ta.style.top = '0';
    document.body.appendChild(ta); ta.focus(); ta.select();
    var ok = false; try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    document.body.removeChild(ta); done(ok);
  }
  function copyText(text, done) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () { done(true); },
        function () { fallbackCopy(text, done); });
    } else { fallbackCopy(text, done); }
  }
  function flash(btn, ok) {
    if (btn._t) { clearTimeout(btn._t); }
    btn.classList.add('copied');
    btn.innerHTML = CHECK_SVG + '<span>' + (ok ? 'コピーしました' : 'コピー失敗') + '</span>';
    btn._t = setTimeout(function () {
      btn.classList.remove('copied');
      btn.innerHTML = COPY_SVG + '<span>コピー</span>';
    }, 1600);
  }

  var TAG_LINE = '#ラレーナのある暮らし #ラレーナ';
  var MENTION_LINE = '@ra_le_na_official';
  var targets = document.querySelectorAll('#sec-features .post-ex, #sec-features .template p:not(.t-note)');
  Array.prototype.forEach.call(targets, function (el) {
    var span = document.createElement('span');
    span.className = 'pe-text';
    while (el.firstChild) { span.appendChild(el.firstChild); }
    el.appendChild(span);
    var tags = document.createElement('span');
    tags.className = 'pe-tags'; tags.textContent = TAG_LINE;
    var mention = document.createElement('span');
    mention.className = 'pe-mention'; mention.textContent = MENTION_LINE;
    el.appendChild(tags); el.appendChild(mention);
    var btn = document.createElement('button');
    btn.type = 'button'; btn.className = 'copy-btn';
    btn.setAttribute('aria-label', '投稿例をコピー');
    btn.innerHTML = COPY_SVG + '<span>コピー</span>';
    el.appendChild(btn);
    el.classList.add('has-copy');
    btn.addEventListener('click', function () {
      var body = span.textContent.replace(/\s+/g, ' ').trim();
      var text = [body, TAG_LINE, MENTION_LINE].join('\n');
      copyText(text, function (ok) { flash(btn, ok); });
    });
  });
})();

/* ============ 最終CTA：SNS投稿ボタン（X Web Intent / Instagram起動＋コピー） ============ */
(function () {
  /* ▼▼ 差し替え設定：投稿先・タグ・メンションを変えたい時はここだけ触る ▼▼ */
  var SNS_TAGS        = '#ラレーナのある暮らし #ラレーナ';        // ハッシュタグ
  var SNS_MENTION     = '@ra_le_na_official';                    // 公式メンション（X/Instagram共通）
  var X_INTENT_BASE   = 'https://twitter.com/intent/tweet';      // ← ここがX投稿URL（x.com/intent/post でも可）
  var IG_APP_SCHEME   = 'instagram://camera';                    // ← ここがInstagram起動URL（ディープリンク）
  var IG_WEB_FALLBACK = 'https://www.instagram.com/';            // ← アプリ未インストール時のフォールバック
  /* ▲▲ 差し替え設定ここまで ▲▲ */

  // X：本文は空・末尾に2改行を空けてから タグ＋メンション をプリセット（本文はユーザーが上に書く）
  var xText = '\n\n' + SNS_TAGS;  // X投稿文はハッシュタグのみ（@メンションは付けない・2026-07-24 FB。Instagram/投稿例のメンションは維持）
  var xLink = document.getElementById('share-x');
  if (xLink) { xLink.setAttribute('href', X_INTENT_BASE + '?text=' + encodeURIComponent(xText)); }

  // Instagram：アプリ起動のみ（未インストール時はWebへ）。自動コピーは行わない
  // （2026-07-24 FB：投稿例のコピーボタンでコピーした本文が、IGボタンの自動コピーで上書きされる害を回避）
  var igBtn = document.getElementById('share-ig');
  if (igBtn) {
    igBtn.addEventListener('click', function () {
      // アプリ起動 → 未インストール（＝ページに留まっている）ときはWebへフォールバック
      var start = Date.now();
      setTimeout(function () {
        if (!document.hidden && (Date.now() - start) < 1800) { window.location.href = IG_WEB_FALLBACK; }
      }, 1200);
      window.location.href = IG_APP_SCHEME;
    });
  }
})();
</script>
</div>

