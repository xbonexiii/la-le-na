<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600;700;900&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap');
/* テーマ既定レイアウト使用時：テーマのフッターと二重化するLP自作フッターのロゴを非表示（法務注記は残す） */
.lp-wrapper .lp-footer .brandmark-logo { display: none !important; }

/* ================== tokens.css（library/土台・インライン内包） ================== */
:root {
  --gold: #A37729; --gold-light: #c49535; --gold-tint: rgba(163,119,41,.1);
  --blue: #0071e3; --text: #1d1d1f; --text-sub: #6e6e73;
  --bg-white: #ffffff; --bg-gray: #f5f5f7; --bg-dark: #1d1d1f; --star: #f5c518;
  --fs-hero: clamp(32px, 5.5vw, 68px); --fs-hero-compact: clamp(30px, 4.2vw, 54px);
  --fs-h2: clamp(28px, 3.5vw, 44px); --fs-h3: 22px; --fs-stat: clamp(28px, 3.6vw, 48px);
  --fs-lead: clamp(16px, 1.6vw, 20px); --fs-body: 17px; --fs-note: 13px; --fs-micro: 12px;
  --ls-hero: -0.03em; --ls-heading: -0.02em; --ls-num: -0.04em;
  --radius-card: 24px; --radius-image: 16px; --radius-badge: 12px; --radius-pill: 50px;
  --shadow-card: 0 2px 20px rgba(0,0,0,.06);
  --section-pad: 100px; --section-pad-sp: 64px;
}
/* ================== base.css（library/土台・インライン内包） ================== */
.lp-wrapper *,  .lp-wrapper *::before,  .lp-wrapper *::after{ box-sizing: border-box; margin: 0; padding: 0; }
.lp-wrapper{ scroll-behavior: smooth; }
.lp-wrapper{ font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 400; font-style: normal; color: var(--text); font-size: var(--fs-body); line-height: 1.7; overflow-x: hidden; }
.lp-wrapper strong,  .lp-wrapper b{ font-weight: 700; }
.lp-wrapper img{ max-width: 100%; height: auto; display: block; }
.lp-wrapper a{ color: inherit; text-decoration: none; }
.lp-wrapper section{ width: 100%; }
.lp-wrapper h1,  .lp-wrapper h2,  .lp-wrapper h3,  .lp-wrapper h4,  .lp-wrapper h5,  .lp-wrapper h6{ color: inherit; font-family: "Noto Serif Japanese", "Noto Serif JP", "Zen Kaku Gothic New", serif; font-weight: 300; font-style: normal; }
.lp-wrapper .container{ max-width: 1200px; margin: 0 auto; padding: 0 40px; }
.lp-wrapper .section-padding{ padding-top: var(--section-pad); padding-bottom: var(--section-pad); }
.lp-wrapper h2.section-title{ font-size: var(--fs-h2); font-weight: 300; line-height: 1.3; letter-spacing: var(--ls-heading); }
.lp-wrapper .hd-nowrap{ white-space: nowrap; }
@media (max-width: 768px) {
  .lp-wrapper{ font-size: 16px; }
  .lp-wrapper .container{ padding: 0 20px; }
  .lp-wrapper .section-padding{ padding-top: var(--section-pad-sp); padding-bottom: var(--section-pad-sp); }
}
.lp-wrapper .fade-in{ opacity: 0; transform: translateY(24px); transition: opacity 0.6s ease, transform 0.6s ease; }
.lp-wrapper .fade-in.visible{ opacity: 1; transform: translateY(0); }
.lp-wrapper .slide-left{ opacity: 0; transform: translateX(-48px); transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-right{ opacity: 0; transform: translateX(48px);  transition: opacity 0.8s ease, transform 0.8s ease; }
.lp-wrapper .slide-up{ opacity: 0; transform: translateY(32px);  transition: opacity 0.7s ease, transform 0.7s ease; }
.lp-wrapper .slide-left.visible,  .lp-wrapper .slide-right.visible,  .lp-wrapper .slide-up.visible{ opacity: 1; transform: none; }
.lp-wrapper .delay-1{ transition-delay: .15s; } .delay-2 { transition-delay: .3s; } .delay-3 { transition-delay: .45s; } .delay-4 { transition-delay: .6s; }
.lp-wrapper .btn-primary{ display: inline-flex; align-items: center; gap: 8px; background: var(--gold); color: #fff; font-size: 18px; font-weight: 700; padding: 18px 40px; border-radius: var(--radius-pill); cursor: pointer; transition: background 0.2s, transform 0.1s; border: none; letter-spacing: 0.02em; }
.lp-wrapper .btn-primary:hover{ background: var(--gold-light); transform: translateY(-1px); }
.lp-wrapper .scroll-hint{ position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 6px; color: rgba(255,255,255,0.55); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; animation: scroll-bounce 2.2s infinite; }
.lp-wrapper .scroll-hint svg{ width: 20px; height: 20px; }
@keyframes scroll-bounce { 0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.55; } 50% { transform: translateX(-50%) translateY(8px); opacity: 0.9; } }
.lp-wrapper #sticky-cta{ display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 8000; padding: 12px 20px 20px; background: linear-gradient(to top, rgba(0,0,0,0.92) 80%, transparent); transform: translateY(0); transition: transform .3s ease; }
.lp-wrapper #sticky-cta.retract{ transform: translateY(110%); }
.lp-wrapper #sticky-cta a{ display: block; width: 100%; text-align: center; background: var(--gold); color: #fff; font-size: 16px; font-weight: 700; padding: 16px; border-radius: var(--radius-badge); }
.lp-wrapper #sticky-cta .sticky-note{ text-align: center; font-size: 11px; color: rgba(255,255,255,0.6); margin-top: 6px; }
@media (min-width: 769px) {
  .lp-wrapper #sticky-cta{ display: none !important; }
}

/* ================== RaLe-Na テーマ（tokens/base の後・色の値だけ上書き） ================== */
:root {
  --gold: #d75a41; --gold-light: #C9AC82; --gold-tint: rgba(215,90,65,.07);
  --cta: #d75a41; --cta-light: #e06e56; --bridge: #A86A3C;
  --bg-white: #FBF7F0; --bg-gray: #F5EFE6; --bg-dark: #1B2845;
  --text: #121212; --text-sub: #6E655A; --star: #E0A93B;
  --navy: #1B2845; --wine: #d75a41; --beige: #C9AC82; --cream: #F5EFE6; --green: #8FA88A;
}
.lp-wrapper .btn-primary{ background: var(--cta); }
.lp-wrapper .btn-primary:hover{ background: var(--cta-light); }
.lp-wrapper #sticky-cta a{ background: var(--cta); }
/* モバイルの固定バナー（scripts.jsがdisplayをinlineでblock化する）を非表示。JSに勝つため!important・1行（2026-07-24 FB） */
.lp-wrapper #sticky-cta{ display: none !important; }
.lp-wrapper{ line-height: 1.9; }

/* eyebrow（見出し上の小ラベル）を非表示＝route-3の作法に合わせる（2026-07-22 FB。hero〜cta の data-slot="eyebrow" 全ラベル） */
.lp-wrapper [data-slot="eyebrow"]{ display: none !important; }

/* ================== 画像・動画プレースホルダー（骨格LP） ================== */
.lp-wrapper .ph-fill{ width: 100%; height: 100%; object-fit: cover; display: block;
  background: repeating-linear-gradient(45deg, rgba(27,40,69,.06), rgba(27,40,69,.06) 12px, rgba(27,40,69,.10) 12px, rgba(27,40,69,.10) 24px); }
.lp-wrapper .ph-video-wrap{ position: relative; width: 100%; }
.lp-wrapper .ph-video-wrap::after{ content: "▶"; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 54px; height: 54px; line-height: 54px; text-align: center; border-radius: 50%;
  background: rgba(27,40,69,.82); color: #fff; font-size: 19px; pointer-events: none; }

/* ================== sec-hero（キャッチ主役写真型・投稿入口） ================== */
.lp-wrapper #sec-hero{ position: relative; min-height: 92vh; min-height: 92svh; display: flex; align-items: center; color: #fff; background: var(--bg-dark); }
.lp-wrapper #sec-hero .hero-bg{ position: absolute; inset: 0; overflow: hidden; }
.lp-wrapper #sec-hero .hero-bg img{ width: 100%; height: 100%; }
/* 黒系オーバーレイ（2026-07-24 FB・濃度を薄めに再調整＝背景写真をもっと活かす）: 下をやや濃く・上を薄く＋左（テキスト側）をやや濃く右を薄く。白文字は明示color＋text-shadow併用で可読を確保 */
.lp-wrapper #sec-hero .hero-bg::after{ content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(18,18,18,.60) 0%, rgba(18,18,18,.38) 45%, rgba(18,18,18,.18) 100%), linear-gradient(to right, rgba(18,18,18,.48) 0%, rgba(18,18,18,.14) 60%, rgba(18,18,18,0) 100%); }
.lp-wrapper #sec-hero .hero-inner{ position: relative; z-index: 1; width: 100%; max-width: 1000px; margin: 0 auto; padding-left: 40px; padding-right: 40px; padding-top: 96px; padding-bottom: 84px; }
.lp-wrapper #sec-hero .hero-eyebrow{ font-size: var(--fs-note); font-weight: 700; letter-spacing: .14em; color: var(--navy); margin-bottom: 18px; }
/* 配色メリハリ（2026-07-24 FB）: 見出しは太く+wineキーワードで主役化・本文は一歩引く・ジャンプピルはwine塗りで強アクセント */
/* 黒背景に映える明色テキスト（行372対策: 白見出しは継承任せにせず #fff を明示指定。テーマの h1,h2{color:#1d1d1f} に負けない） */
.lp-wrapper #sec-hero h1{ font-size: var(--fs-hero-compact); font-weight: 600; line-height: 1.4; letter-spacing: var(--ls-heading); color: #fff; max-width: 720px; margin-bottom: 18px; text-shadow: 0 1px 4px rgba(0,0,0,.45); }
.lp-wrapper #sec-hero h1 .hl{ color: var(--cta-light); }
.lp-wrapper #sec-hero .hero-sub{ font-size: var(--fs-lead); font-weight: 700; line-height: 1.7; color: #fff; max-width: 640px; margin-bottom: 22px; text-shadow: 0 1px 3px rgba(0,0,0,.4); }
.lp-wrapper #sec-hero .hero-body{ font-size: var(--fs-body); line-height: 1.95; color: rgba(255,255,255,.90); max-width: 640px; margin-bottom: 28px; text-shadow: 0 1px 3px rgba(0,0,0,.45); }
.lp-wrapper #sec-hero .hero-jump{ display: inline-flex; align-items: center; justify-content: space-between; gap: 14px; padding: 13px 22px; border: none; border-radius: var(--radius-pill); background: var(--cta); box-shadow: 0 4px 16px rgba(0,0,0,.35); }
.lp-wrapper #sec-hero .hero-jump strong{ color: #fff; font-size: var(--fs-note); font-weight: 700; letter-spacing: .01em; }
.lp-wrapper #sec-hero .hero-jump span{ color: rgba(255,255,255,.85); font-size: var(--fs-micro); font-weight: 700; white-space: nowrap; }
.lp-wrapper #sec-hero .scroll-hint{ color: rgba(255,255,255,.6); }
@media (max-width: 768px) {
  .lp-wrapper #sec-hero .hero-inner{ padding-left: 22px; padding-right: 22px; padding-top: 84px; padding-bottom: 92px; }
  .lp-wrapper #sec-hero h1{ font-size: calc(var(--fs-hero-compact) * 0.86); line-height: 1.45; }
  .lp-wrapper #sec-hero .hero-jump{ width: 100%; flex-direction: column; align-items: flex-start; gap: 6px; }
}

/* ================== 生声吹き出し（共通部品・B2/B3/B6で再利用） ================== */
.lp-wrapper .voices{ display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
.lp-wrapper .voice{ display: flex; align-items: flex-start; gap: 12px; min-width: 0; }
.lp-wrapper .voice .avatar{ width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0; background: var(--gold-tint); border: 1px solid rgba(215,90,65,.18); display: flex; align-items: center; justify-content: center; }
.lp-wrapper .voice .avatar svg{ width: 24px; height: 24px; color: var(--wine); }
.lp-wrapper .voice .bubble{ position: relative; flex: 1; min-width: 0; background: #fff; border: 1px solid rgba(27,40,69,.12); border-radius: var(--radius-card); padding: 15px 18px 13px; }
.lp-wrapper .voice .bubble::before,  .lp-wrapper .voice .bubble::after{ content: ""; position: absolute; top: 16px; width: 0; height: 0; border-style: solid; border-width: 8px 10px 8px 0; }
.lp-wrapper .voice .bubble::before{ left: -10px; border-color: transparent rgba(27,40,69,.12) transparent transparent; }
.lp-wrapper .voice .bubble::after{ left: -9px; border-color: transparent #fff transparent transparent; }
.lp-wrapper .voice .v-meta{ display: flex; align-items: center; gap: 10px; margin-bottom: 7px; }
.lp-wrapper .voice .v-stars{ color: var(--star); font-size: var(--fs-note); letter-spacing: 2px; line-height: 1; }
.lp-wrapper .voice .v-src{ font-size: var(--fs-micro); color: var(--text-sub); margin-left: auto; background: var(--bg-gray); border-radius: var(--radius-pill); padding: 3px 10px; white-space: nowrap; }
.lp-wrapper .voice .bubble p{ font-size: var(--fs-note); line-height: 1.85; color: var(--text); letter-spacing: var(--ls-heading); }
.lp-wrapper .voice-src-note{ font-size: var(--fs-micro); color: var(--text-sub); margin-top: 12px; }

/* ================== sec-empathy（プチストレス共感） ================== */
.lp-wrapper #sec-empathy{ background: var(--bg-white); }
.lp-wrapper #sec-empathy .em-inner{ max-width: 680px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-empathy .em-label{ font-size: var(--fs-note); font-weight: 700; letter-spacing: .12em; color: var(--wine); margin-bottom: 14px; }
.lp-wrapper #sec-empathy h2{ font-size: var(--fs-h2); font-weight: 300; line-height: 1.5; letter-spacing: var(--ls-heading); color: var(--navy); margin-bottom: 24px; }
.lp-wrapper #sec-empathy .em-img{ width: 100%; height: 300px; border-radius: var(--radius-image); overflow: hidden; box-shadow: var(--shadow-card); margin-bottom: 26px; }
.lp-wrapper #sec-empathy .em-body p{ font-size: var(--fs-body); line-height: 2.05; color: var(--text); margin-bottom: 20px; }
.lp-wrapper #sec-empathy .em-voices{ margin: 28px 0; }
@media (max-width: 768px) {
  .lp-wrapper #sec-empathy .em-img{ height: 220px; }
}

/* ================== sec-solution（解消・アフター） ================== */
.lp-wrapper #sec-solution{ background: var(--bg-gray); }
.lp-wrapper #sec-solution .so-inner{ max-width: 680px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-solution .so-label{ font-size: var(--fs-note); font-weight: 700; letter-spacing: .12em; color: var(--wine); margin-bottom: 14px; }
.lp-wrapper #sec-solution h2{ font-size: var(--fs-h2); font-weight: 300; line-height: 1.5; letter-spacing: var(--ls-heading); color: var(--navy); margin-bottom: 24px; }
.lp-wrapper #sec-solution .so-img{ width: 100%; height: 340px; border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--shadow-card); margin-bottom: 26px; }
.lp-wrapper #sec-solution .so-body{ font-size: var(--fs-body); line-height: 2.05; color: var(--text); margin-bottom: 26px; }
.lp-wrapper #sec-solution .so-body sup{ color: var(--wine); }
@media (max-width: 768px) {
  .lp-wrapper #sec-solution .so-img{ height: 240px; }
}

/* ================== sec-proof（投稿正当性＋数字帯） ================== */
.lp-wrapper #sec-proof{ background: var(--bg-white); }
.lp-wrapper #sec-proof .pr-inner{ max-width: 720px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-proof .pr-label{ font-size: var(--fs-note); font-weight: 700; letter-spacing: .12em; color: var(--gold-light); margin-bottom: 14px; }
.lp-wrapper #sec-proof h2{ font-size: var(--fs-h2); font-weight: 300; line-height: 1.5; letter-spacing: var(--ls-heading); color: var(--navy); margin-bottom: 22px; }
.lp-wrapper #sec-proof .pr-body{ font-size: var(--fs-body); line-height: 2.05; color: rgba(27,40,69,.86); margin-bottom: 30px; }
.lp-wrapper #sec-proof .rv-summary{ background: #fff; border-radius: var(--radius-card); padding: 30px 28px; display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 30px; box-shadow: var(--shadow-card); }
.lp-wrapper #sec-proof .rv-score{ text-align: center; }
.lp-wrapper #sec-proof .rv-avg{ font-size: var(--fs-stat); font-weight: 700; line-height: 1.05; letter-spacing: var(--ls-num); color: var(--wine); white-space: nowrap; }
.lp-wrapper #sec-proof .rv-avg em{ font-style: normal; font-size: 0.35em; font-weight: 700; color: var(--text-sub); letter-spacing: var(--ls-heading); margin-left: 4px; }
.lp-wrapper #sec-proof .rv-avg-stars{ color: var(--star); font-size: var(--fs-lead); letter-spacing: 3px; line-height: 1.3; margin-top: 6px; }
.lp-wrapper #sec-proof .rv-count{ font-size: var(--fs-note); font-weight: 700; color: var(--text); white-space: nowrap; margin-top: 6px; }
.lp-wrapper #sec-proof .rv-facts{ border-left: 1px solid rgba(27,40,69,.14); padding-left: 26px; }
.lp-wrapper #sec-proof .rv-facts li{ list-style: none; font-size: var(--fs-note); line-height: 1.85; color: var(--text); margin-bottom: 8px; padding-left: 20px; position: relative; }
.lp-wrapper #sec-proof .rv-facts li::before{ content: ""; position: absolute; left: 0; top: 9px; width: 8px; height: 8px; border-radius: 50%; background: var(--beige); }
.lp-wrapper #sec-proof .rv-facts .award{ color: var(--navy); font-weight: 700; }
.lp-wrapper #sec-proof .rv-note{ font-size: var(--fs-micro); color: rgba(27,40,69,.72); margin-top: 14px; }
@media (max-width: 768px) {
  .lp-wrapper #sec-proof .rv-summary{ grid-template-columns: 1fr; gap: 22px; padding: 26px 20px; }
  .lp-wrapper #sec-proof .rv-facts{ border-left: none; border-top: 1px solid rgba(27,40,69,.14); padding-left: 0; padding-top: 20px; }
}

/* ================== sec-brand（共創の大義・手紙型） ================== */
.lp-wrapper #sec-brand{ background: var(--bg-gray); }
.lp-wrapper #sec-brand .bd-inner{ max-width: 680px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-brand .bd-label{ font-size: var(--fs-note); font-weight: 700; letter-spacing: .12em; color: var(--wine); margin-bottom: 14px; }
.lp-wrapper #sec-brand h2{ font-size: var(--fs-h2); font-weight: 300; line-height: 1.55; letter-spacing: var(--ls-heading); color: var(--navy); margin-bottom: 28px; }
.lp-wrapper #sec-brand .bd-letter{ border-left: 3px solid var(--beige); padding-left: 22px; }
.lp-wrapper #sec-brand .bd-letter p{ font-size: var(--fs-body); line-height: 2.15; color: var(--text); }
.lp-wrapper #sec-brand .bd-letter .bd-core{ font-size: var(--fs-lead); font-weight: 700; line-height: 1.9; color: var(--wine); margin-top: 16px; }

/* ================== sec-features（撮る対象・番号カード11＋動画＋テンプレ） ================== */
.lp-wrapper #sec-features{ background: var(--bg-white); }
.lp-wrapper #sec-features .ft-inner{ max-width: 760px; width: calc(100% - 40px); margin: 0 auto; text-align: left; }
.lp-wrapper #sec-features .ft-label{ font-size: var(--fs-note); font-weight: 700; letter-spacing: .12em; color: var(--wine); margin-bottom: 14px; }
.lp-wrapper #sec-features h2{ font-size: var(--fs-h2); font-weight: 300; line-height: 1.5; letter-spacing: var(--ls-heading); color: var(--navy); margin-bottom: 20px; }
.lp-wrapper #sec-features .ft-intro{ font-size: var(--fs-body); line-height: 2.05; color: var(--text); margin-bottom: 12px; }
.lp-wrapper #sec-features .cluster-label{ font-size: var(--fs-note); font-weight: 700; color: var(--wine); margin: 36px 0 4px; }
/* 横スクロール・フルワイズカード（11特徴・2026-07-22 FB。ralena.jpトップの特徴横スクロールUI参考） */
/* カード列だけフルブリード（画面幅100%）。body横スクロールは width:100vw を使わず width:100%＋overflow-x:auto で防ぐ。左paddingでタイトル左端に揃え・スクロールバー非表示・左右矢印 */
.lp-wrapper #sec-features .ft-cards{ position: relative; width: 100%; }
.lp-wrapper #sec-features .ft-scroller{ width: 100%; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scroll-padding-left: max(20px, calc((100% - 1040px) / 2)); -webkit-overflow-scrolling: touch; padding: 4px 20px 20px; padding-left: max(20px, calc((100% - 1040px) / 2)); margin: 22px 0 4px; scrollbar-width: none; -ms-overflow-style: none; }
.lp-wrapper #sec-features .ft-scroller::-webkit-scrollbar{ display: none; }
.lp-wrapper #sec-features .ft-arrow{ position: absolute; top: 80px; z-index: 3; width: 48px; height: 48px; border-radius: 50%; border: none; background: #fff; color: var(--wine); font-size: 28px; line-height: 1; cursor: pointer; box-shadow: 0 2px 14px rgba(27,40,69,.20); display: flex; align-items: center; justify-content: center; padding-bottom: 3px; transition: background .15s, color .15s, transform .1s; }
.lp-wrapper #sec-features .ft-arrow:hover{ background: var(--wine); color: #fff; transform: translateY(-1px); }
.lp-wrapper #sec-features .ft-prev{ left: max(12px, calc((100% - 1040px) / 2 - 24px)); }
.lp-wrapper #sec-features .ft-next{ right: 16px; }
@media (max-width: 768px) {
  .lp-wrapper #sec-features .ft-arrow{ display: none; }
}
.lp-wrapper #sec-features .ft-track{ display: flex; gap: 16px; width: max-content; align-items: stretch; }
.lp-wrapper #sec-features .hcard{ flex: 0 0 auto; width: min(86vw, 420px); scroll-snap-align: start; background: var(--bg-gray); border-radius: var(--radius-card); overflow: hidden; display: flex; flex-direction: column; }
.lp-wrapper #sec-features .hc-img{ width: 100%; height: 200px; object-fit: cover; display: block; background: var(--bg-white); }
.lp-wrapper #sec-features .hc-body{ padding: 20px 20px 22px; display: flex; flex-direction: column; flex: 1; }
.lp-wrapper #sec-features .hc-head{ display: flex; align-items: baseline; gap: 12px; margin-bottom: 10px; }
.lp-wrapper #sec-features .hc-num{ font-size: var(--fs-h3); font-weight: 700; letter-spacing: var(--ls-num); color: var(--wine); line-height: 1; flex-shrink: 0; }
.lp-wrapper #sec-features .hc-title{ font-size: var(--fs-lead); font-weight: 300; line-height: 1.45; color: var(--navy); }
.lp-wrapper #sec-features .hc-desc{ font-size: var(--fs-note); line-height: 1.8; color: var(--text); }
