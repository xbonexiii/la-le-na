  }
  .lcr-wrap #sec-features .feature-image-wrap img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }
  .lcr-wrap #sec-features .feature-content { padding: 28px; }
  .lcr-wrap #sec-features .feature-number {
    font-size: 52px;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  .lcr-wrap #sec-features .feature-title {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
  }
  .lcr-wrap #sec-features .feature-body {
    font-size: 15px;
    color: rgba(255,255,255,0.7);
    line-height: 1.7;
  }


  /* ============================================
