    color: rgba(255,255,255,0.88);
    margin-bottom: 40px;
    line-height: 1.7;
    max-width: 560px;
  }
  .lcr-wrap #sec-hero .cta-note {
    font-size: 13px;
    color: rgba(255,255,255,0.65);
    margin-top: 16px;
  }


  /* ============================================
     SEC-STORY
  ============================================ */
  .lcr-wrap #sec-story { background: var(--bg-cream); }
  .lcr-wrap #sec-story .story-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .lcr-wrap #sec-story .section-title { margin-bottom: 28px; }
  .lcr-wrap #sec-story .story-quote {
    font-size: 17px;
    font-style: italic;
    color: #3a3a3a;
    border-left: 3px solid var(--gold);
    padding-left: 20px;
    margin-bottom: 32px;
    line-height: 1.8;
  }
  .lcr-wrap #sec-story .story-stats {
    display: flex;
    gap: 32px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .lcr-wrap #sec-story .stat-item { text-align: center; }
  .lcr-wrap #sec-story .stat-number {
    font-size: 48px;
    font-weight: 700;
    color: var(--wine);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .lcr-wrap #sec-story .stat-unit {
    font-size: 18px;
