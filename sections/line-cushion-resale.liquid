  }
  .lcr-wrap #sec-sale .sale-table .price-highlight {
    font-size: 17px;
    font-weight: 700;
    color: var(--wine);
  }
  .lcr-wrap #sec-sale .sale-image-wrap {
    border-radius: 20px;
    overflow: hidden;
  }
  .lcr-wrap #sec-sale .sale-image-wrap img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    display: block;
  }
  .lcr-wrap #sec-sale .sale-cta-wrap {
    margin-top: 36px;
  }


  /* ============================================
     SEC-LINE
  ============================================ */
  .lcr-wrap #sec-line { background: var(--bg-gray); }
  .lcr-wrap #sec-line .section-title { text-align: center; margin-bottom: 16px; }
  .lcr-wrap #sec-line .line-subtitle {
    text-align: center;
    color: #6e6e73;
    margin-bottom: 56px;
    font-size: 17px;
  }
  .lcr-wrap #sec-line .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 56px;
  }
  .lcr-wrap #sec-line .step-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 20px rgba(0,0,0,0.06);
  }
  .lcr-wrap #sec-line .step-image-wrap img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }
  .lcr-wrap #sec-line .step-content { padding: 24px; }
  .lcr-wrap #sec-line .step-number {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
