  .lcr-wrap #sec-hero .eyebrow {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .lcr-wrap #sec-hero h1 {
