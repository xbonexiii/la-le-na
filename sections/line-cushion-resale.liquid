  }
  .lcr-wrap #sec-story .story-image-wrap img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    display: block;
  }


  /* ============================================
     SEC-FEATURES
  ============================================ */
  .lcr-wrap #sec-features { background: var(--bg-dark); color: #fff; }
  .lcr-wrap #sec-features .container { text-align: center; }
  .lcr-wrap #sec-features .section-title {
    color: #fff;
    margin-bottom: 16px;
  }
  .lcr-wrap #sec-features .features-lead {
    font-size: 17px;
    color: rgba(255,255,255,0.65);
    margin-bottom: 56px;
  }
  .lcr-wrap #sec-features .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
