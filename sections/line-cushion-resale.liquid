  .lcr-wrap #sec-hero .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.6;
  }
  .lcr-wrap #sec-hero .hero-overlay {
