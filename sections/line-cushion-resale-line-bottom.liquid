<script>
(function () {
  var targets = document.querySelectorAll('.lcr-wrap .slide-left, .lcr-wrap .slide-right, .lcr-wrap .slide-up, .lcr-wrap .fade-in');
  if (!('IntersectionObserver' in window)) {
    targets.forEach(function (el) { el.classList.add('visible'); }); return;
  }
  var obs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.15 });
  targets.forEach(function (el) { obs.observe(el); });
})();
</script>

<script>
(function () {
  if (window.matchMedia('(max-width: 768px)').matches) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var els = Array.prototype.slice.call(document.querySelectorAll('.lcr-wrap .parallax-bg'));
  var STRENGTH = 40; var ticking = false;
  function update() {
    var vh = window.innerHeight;
    els.forEach(function (img) {
      var section = img.parentElement;
      var rect = section.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > vh) return;
      var offset = (rect.top + rect.height / 2 - vh / 2) / (vh + rect.height) * STRENGTH * 2;
      img.style.transform = 'translateY(' + offset.toFixed(2) + 'px)';
    });
    ticking = false;
  }
  window.addEventListener('scroll', function () {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
  update();
})();
</script>

<script>
(function () {
  if (window.matchMedia('(min-width: 769px)').matches) return;
  var el = document.getElementById('lcr-sticky-cta');
  if (!el) return;
  el.style.display = 'block';
  var unlocked = false;
  var lastY = window.scrollY;
  var trigger = document.getElementById('pg-feature2');
  if (trigger && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { unlocked = true; el.classList.add('visible'); }
      });
    }, { threshold: 0.1 }).observe(trigger);
  }
  var finalCta = document.getElementById('sec-cta');
  var finalVisible = false;
  if (finalCta && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { finalVisible = true; el.classList.remove('visible'); }
        else { finalVisible = false; }
      });
    }, { threshold: 0.1 }).observe(finalCta);
  }
  window.addEventListener('scroll', function () {
    if (!unlocked) { lastY = window.scrollY; return; }
    var currentY = window.scrollY;
    if (currentY < lastY - 4) {
      el.classList.remove('visible');
    } else if (currentY > lastY + 4 && !finalVisible) {
      el.classList.add('visible');
    }
    lastY = currentY;
  }, { passive: true });
})();
</script>

<script>
(function () {
  if (window.matchMedia('(max-width: 768px)').matches) return;
  var banner = document.getElementById('pc-fixed-banner');
  if (!banner) return;
  banner.style.display = 'block';
  var shown = false;
  var closed = false;
  var trigger = document.getElementById('sec-hero');
  function show() { if (closed) return; shown = true; banner.classList.add('visible'); }
  if (trigger && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (!e.isIntersecting && window.scrollY > 100) show(); });
    }, { threshold: 0 }).observe(trigger);
  } else {
    window.addEventListener('scroll', function () { if (!shown && window.scrollY > window.innerHeight * 0.8) show(); }, { passive: true });
  }
  var closeBtn = document.getElementById('pc-fixed-banner-close');
  if (closeBtn) {
    closeBtn.addEventListener('click', function () {
      closed = true; banner.classList.remove('visible');
      setTimeout(function () { banner.style.display = 'none'; }, 400);
    });
  }
})();

(function () {
  function hsLpOpenModal(blockId) {
    var tpl = document.getElementById('hs-lp-data-' + blockId);
    if (!tpl) return;
    var content = document.getElementById('HsLpModalContent');
    content.innerHTML = '';
    content.appendChild(tpl.content.cloneNode(true));
    var overlay = document.getElementById('HsLpModalOverlay');
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    document.getElementById('HsLpModalClose').focus();
  }
  function hsLpCloseModal() {
    var overlay = document.getElementById('HsLpModalOverlay');
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  document.querySelectorAll('[data-hs-modal]').forEach(function (btn) {
    btn.addEventListener('click', function () { hsLpOpenModal(this.dataset.hsModal); });
  });
  var closeBtn = document.getElementById('HsLpModalClose');
  if (closeBtn) closeBtn.addEventListener('click', hsLpCloseModal);
  var overlay = document.getElementById('HsLpModalOverlay');
  if (overlay) overlay.addEventListener('click', function (e) { if (e.target === this) hsLpCloseModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hsLpCloseModal(); });
})();

function hsLpScroll(sectionId, direction) {
  var container = document.getElementById('HsLpScroll-' + sectionId);
  if (!container) return;
  container.scrollBy({ left: direction === 'left' ? -420 : 420, behavior: 'smooth' });
}
</script>

<script>
(function () {
  var box = document.querySelector('.hero-countdown');
  if (!box) return;
  var end = new Date(box.getAttribute('data-countdown-end')).getTime();
  var fields = {
    days: box.querySelector('[data-cd="days"]'),
    hours: box.querySelector('[data-cd="hours"]'),
    minutes: box.querySelector('[data-cd="minutes"]'),
    seconds: box.querySelector('[data-cd="seconds"]')
  };
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function tick() {
    var diff = end - Date.now();
    if (diff <= 0) {
      box.innerHTML = '<p class="countdown-ended">割引期間は終了しました。次回の再販をお楽しみに。</p>';
      clearInterval(iv);
      return;
    }
    var s = Math.floor(diff / 1000);
    fields.days.textContent = Math.floor(s / 86400);
    fields.hours.textContent = pad(Math.floor((s % 86400) / 3600));
    fields.minutes.textContent = pad(Math.floor((s % 3600) / 60));
    fields.seconds.textContent = pad(s % 60);
  }
  tick();
  var iv = setInterval(tick, 1000);
})();
</script>


