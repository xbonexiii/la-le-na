              <line x1="105.5" y1="28.5" x2="109.5" y2="21.5"/><line x1="94.5" y1="28.5" x2="90.5" y2="21.5"/>
            </g>
            <!-- 出た成分のしずく（落ちていく途中） -->
            <path d="M100 66 q0 7 3.6 11 a4.6 4.6 0 1 1 -7.2 0 q3.6 -4 3.6 -11z" fill="#d75a41" opacity=".85"/>
            <!-- 板の断面。上面の線が「穴のない表面」 -->
