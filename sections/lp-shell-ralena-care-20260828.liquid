<style>

/* ================== 公式サイトと同じ書体（ralena.jp が配信している実ファイル） ================== */
@font-face {
  font-family: "Zen Kaku Gothic New"; font-weight: 400; font-style: normal; font-display: swap;
  src: url("https://ralena.jp/cdn/fonts/zen_kaku_gothic_new/zenkakugothicnew_n4.04cfb790a87c2fa56f40f47191b8c05620cc5b9c.woff2") format("woff2");
}
@font-face {
  font-family: "Zen Kaku Gothic New"; font-weight: 700; font-style: normal; font-display: swap;
  src: url("https://ralena.jp/cdn/fonts/zen_kaku_gothic_new/zenkakugothicnew_n7.c629355112e2c4394bf64889a68f5ace346cfdd0.woff2") format("woff2");
}
@font-face {
  font-family: "Noto Serif Japanese"; font-weight: 300; font-style: normal; font-display: swap;
  src: url("https://ralena.jp/cdn/fonts/noto_serif_japanese/notoserifjapanese_n3.66b12402bb66176447066e1ce97a0e4bd0ccb97f.woff2") format("woff2");
}

/* ================== トークン（すべて公式サイトの実測値） ================== */
:root {
  --serif: "Noto Serif Japanese", "Hiragino Mincho ProN", "Yu Mincho", serif;
  --sans: "Zen Kaku Gothic New", "Hiragino Kaku Gothic ProN", "Hiragino Sans", sans-serif;

  --fg: #121212;                    /* 見出し・強い文字 */
  --fg-body: rgba(18,18,18,.75);    /* 本文 */
  --fg-mute: rgba(18,18,18,.55);    /* 注記 */
  --bg: #ffffff;
  --bg-soft: #f3f3f3;               /* 区切りの薄グレー（color-scheme-2） */
  --bg-beige: #ecdfd7;              /* フッターのベージュ */
  --dark: #242833;                  /* 濃い面（color-scheme-3） */
  --terracotta: #d75a41;            /* CTA・強調 */
  --line-green: #06c755;
  --line-green-hover: #05b34c;
  --rule: rgba(18,18,18,.12);       /* 罫線 */

  --fs-body: 16.8px;                /* 公式の本文（1.5rem × 1.05） */
  --fs-note: 14.7px;                /* 公式のQ&Aの質問と同じ */
  --fs-micro: 12.6px;
  --fs-h1: 40px;                    /* 公式のFV見出し */
  --fs-h2: 28px;
  --fs-h3: 24px;                    /* 公式のセクション見出し */
  --ls-head: .6px;                  /* 公式の見出しの字間 */
  --ls-body: .63px;                 /* 公式の本文の字間 */

  --w-text: 740px;                  /* 本文カラム（公式FAQの見出し幅 739.19px） */
  --btn-radius: 41px;               /* 公式のボタン */
  --box-radius: 8px;                /* 公式の --text-boxes-radius */
  --sec-pad: 76px;
  --sec-pad-sp: 48px;
}

/* ================== ベース ================== */
.lp-wrapper *,  .lp-wrapper *::before,  .lp-wrapper *::after{ box-sizing: border-box; margin: 0; padding: 0; }
.lp-wrapper{ scroll-behavior: smooth; }
.lp-wrapper{
  font-family: var(--sans); font-weight: 400; font-size: var(--fs-body);
  letter-spacing: var(--ls-body); line-height: 1.76; color: var(--fg-body);
  background: var(--bg); overflow-x: hidden; -webkit-font-smoothing: antialiased;
}
.lp-wrapper img{ max-width: 100%; height: auto; display: block; border-radius: 0; }  /* 公式は画像に角丸を付けない */
.lp-wrapper a{ color: inherit; text-decoration: none; }
.lp-wrapper section{ width: 100%; }
/* 見出しは明朝・細字・中央そろえ（公式サイトの h1〜h5 と同じ）。
   color を明示するのは、本番テーマの見出し色指定に写真上・濃い面の白見出しが負けて黒くなるのを防ぐため */
.lp-wrapper h1,  .lp-wrapper h2,  .lp-wrapper h3,  .lp-wrapper h4{
  font-family: var(--serif); font-weight: 300; letter-spacing: var(--ls-head);
  line-height: 1.3; color: var(--fg); text-align: center;
}
.lp-wrapper .section-pad{ padding-top: var(--sec-pad); padding-bottom: var(--sec-pad); }
.lp-wrapper .inner{ max-width: var(--w-text); width: calc(100% - 105px); margin: 0 auto; }
.lp-wrapper .hd-nowrap{ white-space: nowrap; }
.lp-wrapper .hd-keep{ white-space: nowrap; }
@media (max-width: 768px) {
  :root { --fs-h1: 30px; --fs-h2: 23px; --fs-h3: 21px; }
  /* 狭幅では塊が1行に入りきらず、行末に大きな空きが並んで逆に読みにくくなる（実測）。
     固定を外してブラウザの折返しに戻し、狭幅でも切れ目を守りたい短い塊だけ .hd-keep で残す */
  .lp-wrapper .hd-nowrap{ white-space: normal; }
  .lp-wrapper .section-pad{ padding-top: var(--sec-pad-sp); padding-bottom: var(--sec-pad-sp); }
  .lp-wrapper .inner{ width: calc(100% - 40px); }
}
/* 動きは控えめに1種類だけ（公式サイトにも派手な動きはない） */
.lp-wrapper .fade-in{ opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }
.lp-wrapper .fade-in.visible{ opacity: 1; transform: none; }
.lp-wrapper .delay-1{ transition-delay: .12s; } .delay-2 { transition-delay: .24s; }
@media (prefers-reduced-motion: reduce) { .fade-in { opacity: 1; transform: none; transition: none; } }

/* ================== 共通部品 ================== */
.lp-wrapper .h-chapter{ font-size: var(--fs-h2); margin-bottom: 34px; } /* 章の見出し（原稿の「■見出し」） */
.lp-wrapper .h-sec{ font-size: var(--fs-h3); margin-bottom: 30px; }     /* 章の中の見出し（原稿の「▼」） */
/* 本文。読み物なので左そろえ（公式FAQの答えの文も左そろえ） */
.lp-wrapper .p{ font-size: var(--fs-body); line-height: 1.9; color: var(--fg-body); text-align: left; }
.lp-wrapper .p + .p{ margin-top: 20px; }
/* ボタン（公式のピル型。色だけ用途で変える） */
.lp-wrapper .btn{
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  min-height: 49.25px; padding: 12px 31.5px; border-radius: var(--btn-radius);
  font-family: var(--sans); font-size: 15.75px; font-weight: 400; letter-spacing: var(--ls-body);
  color: #fff; transition: background .2s, transform .1s;
}
.lp-wrapper .btn svg{ width: 22px; height: 22px; flex-shrink: 0; }
.lp-wrapper .btn-line{ background: var(--line-green); }
.lp-wrapper .btn-line:hover{ background: var(--line-green-hover); transform: translateY(-1px); }
/* 画像の仮枠。確定素材に見えると社内確認で見落とすため、破線と斜線で「仮」と分かる形にしている */
.lp-wrapper .ph{ position: relative; width: 100%; border: 1px dashed rgba(18,18,18,.3);
  background: repeating-linear-gradient(45deg, rgba(18,18,18,.03), rgba(18,18,18,.03) 12px, rgba(18,18,18,.06) 12px, rgba(18,18,18,.06) 24px);
  display: flex; align-items: center; justify-content: center; }
.lp-wrapper .ph span{ font-size: var(--fs-micro); color: var(--fg-mute); background: rgba(255,255,255,.9);
  padding: 8px 12px; text-align: center; line-height: 1.8; max-width: 88%; }

/* ================== S1 hero（写真全面＋中央の明朝の白見出し／公式FAQのFVと同じ組み） ================== */
.lp-wrapper #sec-hero{ position: relative; }
.lp-wrapper #sec-hero .hero-bg{ position: absolute; inset: 0; overflow: hidden; }
/* 見出しは画面の中央に置くので、まな板はその下に来る位置に寄せる。
     62%（板が画面中央）だと白い見出しが黒い板の上に重なって沈む（実測） */
.lp-wrapper #sec-hero .hero-bg img{ width: 100%; height: 100%; object-fit: cover; object-position: 50% 34%; }
/* 公式FAQのFVと同じく、写真全体に均一の暗幕を敷いて中央の白文字を読ませる（overlay_opacity 50%） */
.lp-wrapper #sec-hero .hero-bg::after{ content: ""; position: absolute; inset: 0; background: rgba(0,0,0,.42); }
.lp-wrapper #sec-hero .hero-inner{ position: relative; z-index: 1; min-height: 588px; display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center; padding: 80px 0; }
.lp-wrapper #sec-hero h1{ font-size: var(--fs-h1); color: #fff; margin-bottom: 22px; }
.lp-wrapper #sec-hero .hero-lead{ font-size: var(--fs-body); line-height: 1.9; color: rgba(255,255,255,.92); text-align: center; }
.lp-wrapper #sec-hero .hero-lead + .hero-lead{ margin-top: 8px; }
@media (max-width: 768px) {
  .lp-wrapper #sec-hero .hero-inner{ min-height: 420px; padding: 64px 0; }
  .lp-wrapper #sec-hero .hero-bg img{ object-position: 50% 40%; }
  .lp-wrapper #sec-hero .hero-lead{ font-size: var(--fs-note); line-height: 1.85; }
}

/* ================== S2 sec-symptom（症状の照合・公式FAQのQ&A行と同じ薄グレーの角丸行） ================== */
.lp-wrapper #sec-symptom{ background: var(--bg); }
.lp-wrapper #sec-symptom .h-sec{ margin-bottom: 22px; }
.lp-wrapper #sec-symptom .sym-list{ margin-bottom: 34px; }
.lp-wrapper #sec-symptom .sym-list li{
  list-style: none; position: relative; background: var(--bg-soft); border-radius: var(--box-radius);
  padding: 17px 22px 17px 52px; margin-bottom: 10px;
  font-size: var(--fs-note); line-height: 1.85; color: var(--fg); text-align: left;
}
.lp-wrapper #sec-symptom .sym-list li:last-child{ margin-bottom: 0; }
/* 頭の四角（チェック欄）。公式FAQの行頭にある「?」アイコンと同じ位置・同じ大きさに置いている */
.lp-wrapper #sec-symptom .sym-list li::before{
  content: ""; position: absolute; left: 22px; top: 50%; margin-top: -8px;
  width: 16px; height: 16px; border: 1px solid rgba(18,18,18,.45); border-radius: 2px;
}
/* 症状の実写真（板全体に白い跡が出ている状態）を1枚だけ大きく見せる。
   2026-08-27 市山さん指示で、拡大図（引き＋アップ＋枠＋結び線）の組みは取りやめ。
   読者がここでやることは「自分の板と見くらべる」ことなので、
   余計な図の仕掛けを外して、写真そのものを本文幅いっぱいで見せる形にした。
   比率は元画像のままの 3:2。
   一度16:9に詰めたが、板の下端が24px切れていた（2026-08-28 市山さん指摘で実測して判明）。
   板は画像の縦 8.3%〜94.5%（＝縦の86.2%）・横 1.7%〜98.3% を占めており、
   16:9（縦84%が残る）では下が入りきらない。板の四辺が見えることを優先して元の3:2に戻した。
   白い余白だけを落とす詰め方（比1.74）も可能だが、板が枠に接して窮屈になり、
   3:2との見た目の差も小さいため採らない。
   白背景で撮られた写真なので、白地のセクションに置くと輪郭が消える。
   公式テーマも画像に1pxの枠を持っている（--media-border-width: 1px）ので、それに倣って細枠で締める
   （公式の既定の濃さ opacity .05 は白地では見えないため、罫線トークンの濃さを使っている）。 */
.lp-wrapper #sec-symptom .sym-photo img{
  width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block;
  box-shadow: inset 0 0 0 1px var(--rule);
}
/* 2026-08-28: 狭幅では画面幅いっぱい（フルブリード）にしていたが、
   板は元画像の横 1.7%〜98.3% を占めるため、端まで広げると板が画面の端に接して
   「四辺が見えている」状態にならなかった。本文カラム内に戻し、左右に余白と枠線を残す。
   3:2 に戻したぶん縦が増えているので（16:9フルブリードの211px → カラム内3:2の223px）、
   板の見える大きさは落ちていない。 */

/* ================== S3 sec-cause（原因の説明＋断面の図解） ================== */
.lp-wrapper #sec-cause{ background: var(--bg-soft); }
.lp-wrapper #sec-cause .cause-photo{ margin: 30px 0; }
.lp-wrapper #sec-cause .cause-photo img{ width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
/* 差し替えた写真は正方形（3072×3072）。ページの他の写真と枠を揃えるため 3:2 のまま縦だけ切る。
   切る位置は目分量で決めず、色で被写体の範囲を実測してから決めた（2026-08-28）:
     きゅうり（丸ごと＋輪切り）… 縦 7.3%〜73.7%
     手（両手）              … 縦 42.4%〜99.2%
     黒い面                  … 縦 5.2%〜80.2%
   65% は元画像の y 665〜2713 を表示する位置。主役（押さえる手・包丁の刃・輪切りのきゅうり）が
   すべて枠に入り、板の左上の角も見えて構図がまとまる。
   包丁の柄を握る右手は下端で一部切れるが、これは料理写真として自然な切れ方（実際に4案を切り出して見比べて決定）。 */
.lp-wrapper #sec-cause .cause-photo-cut{ object-position: 50% 65%; }
/* 因果の図（3コマ）。まな板を横から見た断面で
   「①成分がのる → ②中まで入らない → ③乾いて白く見える」を1本の流れにする。
   囲みは公式の --text-boxes-radius（8px）・白地・細罫線 */
.lp-wrapper #sec-cause .flow{ margin-top: 34px; background: var(--bg); border: 1px solid var(--rule); border-radius: var(--box-radius); padding: 32px 28px; }
.lp-wrapper #sec-cause .flow-steps{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; align-items: start; }
.lp-wrapper #sec-cause .flow-step{ position: relative; text-align: center; }
.lp-wrapper #sec-cause .flow-step svg{ width: 100%; height: auto; display: block; }
/* 図のラベルは明朝ではなくゴシック（見出しではなく図の注記のため） */
.lp-wrapper #sec-cause .flow-step p{ font-family: var(--sans); font-size: var(--fs-micro); line-height: 1.7; color: var(--fg); margin-top: 12px; }
/* コマ間の進行の三角。線ではなく小さな図形1つだけにして、図の中の情報を増やさない */
.lp-wrapper #sec-cause .flow-step:not(:last-child)::after{
  content: ""; position: absolute; right: -17px; top: 44px;
  border-left: 7px solid rgba(18,18,18,.28); border-top: 5px solid transparent; border-bottom: 5px solid transparent;
}
@media (max-width: 768px) {
  /* 狭幅で3列のままだと1コマ88px程度まで縮んで断面の層が潰れる。縦積みにする */
  .lp-wrapper #sec-cause .flow-steps{ grid-template-columns: 1fr; gap: 34px; }
  .lp-wrapper #sec-cause .flow-step{ max-width: 250px; margin: 0 auto; }
  .lp-wrapper #sec-cause .flow{ padding: 24px 20px; }
  .lp-wrapper #sec-cause .flow-step:not(:last-child)::after{
    right: auto; left: 50%; top: auto; bottom: -24px; margin-left: -5px;
    border-left: 5px solid transparent; border-right: 5px solid transparent;
    border-top: 7px solid rgba(18,18,18,.28); border-bottom: 0;
  }
}

/* ================== S4 sec-howto（落とし方・2ステップ） ================== */
.lp-wrapper #sec-howto{ background: var(--bg); }
.lp-wrapper #sec-howto .steps{ border-top: 1px solid var(--rule); }
.lp-wrapper #sec-howto .step{ padding: 34px 0; border-bottom: 1px solid var(--rule); }
/* 番号は明朝で丸の中に置く（公式サイトに番号バッジは無いので、書体と細罫線でトンマナを合わせている） */
.lp-wrapper #sec-howto .step-num{
  width: 42px; height: 42px; border-radius: 50%; border: 1px solid rgba(18,18,18,.35);
  display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;
  font-family: var(--serif); font-weight: 300; font-size: 19px; color: var(--fg); letter-spacing: 0;
}
.lp-wrapper #sec-howto .step > p{ font-size: var(--fs-body); line-height: 1.9; color: var(--fg-body); text-align: left; }
.lp-wrapper #sec-howto .step > p + p{ margin-top: 18px; }
.lp-wrapper #sec-howto .step-photo{ margin-top: 22px; }
.lp-wrapper #sec-howto .step-photo img{ width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
/* 手順2は正方形（4500×4500）の写真。手順1と枠を揃えるため 3:2 のまま縦だけ切るが、
   主役（板・泡・手）が下寄りなので中央のままだと板の下端と手が切れる。
   表示位置を下に寄せて、板の全体と持ち手が枠に収まる位置にした（実測で決めた値） */
.lp-wrapper #sec-howto .step-photo-spray{ object-position: 50% 62%; }
/* 60℃の注意。手順1に従属する注意なので別カードに切り出さず、ステップの中に置く。
   テラコッタの縦線1本で「ここは読み飛ばさない」を示す（公式サイトの強調色と同じ色） */
.lp-wrapper #sec-howto .caution{ display: flex; gap: 13px; align-items: flex-start; border-left: 2px solid var(--terracotta); padding: 4px 0 4px 18px; margin-top: 18px; }
.lp-wrapper #sec-howto .caution svg{ width: 20px; height: 20px; color: var(--terracotta); flex-shrink: 0; margin-top: 4px; }
.lp-wrapper #sec-howto .caution p{ font-size: var(--fs-note); line-height: 1.85; color: var(--fg-body); text-align: left; }
.lp-wrapper #sec-howto .caution b{ font-weight: 700; color: var(--fg); }
/* 手順2の時間。本文の文はそのまま残したうえで、流し読みでも「約5分」「30秒以上」が拾えるように置く。
   文言は原稿の連続した句をそのまま引いている（説明語を新しく足していない） */
.lp-wrapper #sec-howto .times{ display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
.lp-wrapper #sec-howto .time{ display: flex; align-items: center; gap: 10px; background: var(--bg-soft); border-radius: var(--box-radius); padding: 13px 18px; }
.lp-wrapper #sec-howto .time svg{ width: 17px; height: 17px; color: rgba(18,18,18,.5); flex-shrink: 0; }
.lp-wrapper #sec-howto .time p{ font-size: var(--fs-micro); color: var(--fg-mute); line-height: 1.6; white-space: nowrap; }
/* 数字だけ明朝で大きく。前置きと助詞は小さいまま＝核が立つ */
.lp-wrapper #sec-howto .time b{ font-family: var(--serif); font-weight: 300; font-size: 23px; color: var(--fg); letter-spacing: 0; margin: 0 3px; }
@media (max-width: 768px) {
  /* 横に並べると1つ150px程度になり句が2行に割れる。縦積みにし、幅を揃えて右端のガタつきを消す */
  .lp-wrapper #sec-howto .times{ flex-direction: column; gap: 8px; align-items: stretch; }
}

/* ================== S5 sec-safety（安全のため、必ずお読みください） ==================
   原稿の装飾指示「（枠で囲んで目立たせる）」の実装。
   面はフッターと同じベージュ、中は白の囲み（公式サイトにある色だけで「ここだけ違う」を作る） */
.lp-wrapper #sec-safety{ background: var(--bg-beige); }
.lp-wrapper #sec-safety .safe-card{ background: var(--bg); border-radius: var(--box-radius); padding: 40px 38px; }
.lp-wrapper #sec-safety .safe-title{ font-size: var(--fs-h3); margin-bottom: 8px; }
/* 見出しの上の警告アイコン。絵文字は使わない（端末ごとに絵柄と色が変わり、原色が並ぶと品が落ちるため） */
.lp-wrapper #sec-safety .safe-icon{ width: 30px; height: 30px; color: var(--terracotta); margin: 0 auto 16px; display: block; }
.lp-wrapper #sec-safety .safe-list{ margin-top: 26px; border-top: 1px solid var(--rule); }
.lp-wrapper #sec-safety .safe-list li{
  list-style: none; display: flex; gap: 15px; align-items: flex-start; padding: 22px 0;
  border-bottom: 1px solid var(--rule); font-size: var(--fs-note); line-height: 1.85; color: var(--fg-body); text-align: left;
}
.lp-wrapper #sec-safety .safe-list li:last-child{ border-bottom: 0; padding-bottom: 4px; }
.lp-wrapper #sec-safety .safe-list li svg{ width: 19px; height: 19px; color: rgba(18,18,18,.45); flex-shrink: 0; margin-top: 5px; }
/* 1項目めだけテラコッタ。3つとも同じ強さにすると「本当に危ないのはどれか」が消える
   （混ぜるとガスが出る＝ここだけが事故に直結する） */
.lp-wrapper #sec-safety .safe-list li.is-danger svg{ color: var(--terracotta); }
.lp-wrapper #sec-safety .safe-list li.is-danger b{ font-weight: 700; color: var(--terracotta); }
@media (max-width: 768px) { #sec-safety .safe-card { padding: 28px 22px; } }

/* ================== S6 sec-prevent（跡を、残りにくくするために） ================== */
.lp-wrapper #sec-prevent{ background: var(--bg); }
/* 締めの一文は級数を上げて読ませる。原稿の文はそのまま・順序も変えていない */
.lp-wrapper #sec-prevent .close-line{ font-family: var(--serif); font-weight: 300; font-size: 21px; line-height: 1.7;
  letter-spacing: var(--ls-head); color: var(--fg); text-align: left; margin-top: 26px; }
.lp-wrapper #sec-prevent .pv-photo{ margin-top: 34px; }
.lp-wrapper #sec-prevent .pv-photo img{ width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
@media (max-width: 768px) {
  .lp-wrapper #sec-prevent .close-line{ font-size: 18px; }
