<!-- LP本体のJS。ページ末尾の制作用パネルより前の、独立した script タグに置くこと。
     パネルの script タグの中や、パネルの目印コメントより後ろに書くと、Shopify反映用のビルドが
     パネルごと丸ごと捨てるため、公開ページだけアニメが発火しなくなる（既知の実バグ）。
     ※ このコメント内に目印の語（除去の起点になる語）を書かないこと。
        書くとビルドがここを起点にしてしまい、下のLP本体JSごと削除される（2026-08-28 実際に発生） -->
<script>
(function () {
  var targets = document.querySelectorAll('.fade-in');
  if (!('IntersectionObserver' in window)) {
    Array.prototype.forEach.call(targets, function (el) { el.classList.add('visible'); });
    return;
  }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) { entry.target.classList.add('visible'); io.unobserve(entry.target); }
    });
  }, { threshold: 0.12 });
  Array.prototype.forEach.call(targets, function (el) { io.observe(el); });
})();
</script>
